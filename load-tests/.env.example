# URL of the Bunker server being tested. Use an isolated staging instance for high load.
TARGET_URL=https://localhost:5001

# http: ordinary Razor/HTTP pages; signalr-ws: SignalR negotiate + WebSocket connection.
TEST_MODE=http
HUB_PATH=/gameHub

# The default is the requested peak. Use a lower number first on a new environment.
MAX_VUS=1099
RAMP_UP=5m
HOLD=10m
RAMP_DOWN=2m
GRACEFUL_RAMP_DOWN=30s
THINK_TIME_SECONDS=1
HTTP_TIMEOUT=30s
WS_SESSION_SECONDS=15
SIGNALR_ACTION=get-rooms

# Set true only for a trusted development certificate.
INSECURE_SKIP_TLS_VERIFY=false

# Result files. Their directories must already exist when k6 is started.
SUMMARY_JSON=load-tests/results/summary.json
SUMMARY_TEXT=load-tests/results/summary.txt

# Optional documentation metadata only. k6 does not open, play, or create Twitch viewers.
TWITCH_STREAM_URL=
