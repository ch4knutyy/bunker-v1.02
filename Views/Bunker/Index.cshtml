@{
    ViewData["Title"] = "Грати";
}

<link rel="stylesheet" href="~/css/game.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/character-cards.css" asp-append-version="true" />

<div class="game-container site-game-shell">
    <div class="top-bar site-titlebar">
        <h1 class="page-title">Vault Judgment</h1>
    </div>

    @* Вибір і створення кімнати *@
    <div id="lobbySection">
        <div class="lobby-container">
            @* Створення нової кімнати *@
            <div class="create-room-panel site-panel">
                <h2 class="section-title site-section-heading">Створити кімнату</h2>

                <div class="create-room-form">
                    <label class="visually-hidden" for="playerNameCreate">Ім'я гравця</label>
                    <input id="playerNameCreate"
                           name="playerNameCreate"
                           type="text"
                           class="input-field"
                           placeholder="Ваше ім'я..."
                           maxlength="10"
                           autocomplete="nickname"
                           oninput="sanitizeNameInput(this)"
                           data-testid="player-name-input" />

                    <label class="visually-hidden" for="roomName">Назва кімнати</label>
                    <input id="roomName"
                           name="roomName"
                           type="text"
                           class="input-field"
                           placeholder="Назва кімнати..."
                           autocomplete="off"
                           data-testid="room-name-input" />

                    <div class="form-row">
                        <label class="visually-hidden" for="maxPlayers">Максимальна кількість гравців</label>
                        <input id="maxPlayers"
                               name="maxPlayers"
                               type="number"
                               class="input-field small"
                               placeholder="Макс. гравців"
                               value="12"
                               min="2"
                               max="12"
                               autocomplete="off"
                               data-testid="room-max-players-input" />

                        <label class="visually-hidden" for="roomPassword">Пароль кімнати</label>
                        <input id="roomPassword"
                               name="roomPassword"
                               type="password"
                               class="input-field"
                               placeholder="Пароль (необов'язково)"
                               autocomplete="new-password"
                               data-testid="room-password-input" />
                    </div>

                    <button type="button"
                            id="createRoomBtn"
                            class="btn-primary"
                            data-testid="create-room-btn">
                        Створити кімнату
                    </button>

                    <p id="connectionStatus"
                       class="connection-status"
                       style="display: none; margin-top: 0.5rem; font-size: 0.85rem;"
                       role="status"
                       aria-live="polite">
                    </p>
                </div>
            </div>

            @* Список доступних кімнат *@
            <div class="rooms-list-panel site-panel">
                <h2 class="section-title site-section-heading">Доступні кімнати</h2>
                <div id="roomsList" class="rooms-list">
                    <p class="no-rooms">Завантаження кімнат...</p>
                </div>
            </div>
        </div>
    </div>

    @* Поточна кімната: lobby та активна гра *@
    <div id="roomSection" style="display: none;">
        <div class="room-header site-command-bar">
            <div class="room-info site-command-identity">
                <h2 class="room-name" id="currentRoomName">Кімната</h2>
                <span class="room-id" id="currentRoomId">ID: ---</span>
                <span class="room-state" id="currentRoomState">Лобі</span>
            </div>

            <div class="room-actions site-command-actions">
                <button id="copyInviteLinkBtn"
                        class="btn-secondary"
                        type="button"
                        data-testid="copy-invite-link-btn"
                        onclick="copyInviteLink()">
                    Посилання
                </button>

                <button id="gmPanelBtn"
                        type="button"
                        class="btn-gm"
                        onclick="toggleGMPanel()"
                        style="display: none;">
                    🎮 GM Панель
                </button>

                <button id="startVotingBtn"
                        type="button"
                        class="btn-vote"
                        onclick="startVoting()"
                        style="display: none;">
                    🗳️ Голосування
                </button>

                <button id="startGameBtn"
                        type="button"
                        class="btn-success"
                        onclick="startGame()"
                        style="display: none;">
                    Почати гру
                </button>

                <button type="button"
                        class="btn-danger"
                        onclick="leaveRoom()">
                    Покинути кімнату
                </button>
            </div>
        </div>

        <div id="omniscientGmBanner"
             class="global-catalog-warning"
             style="display: none;"
             role="status">
        </div>

        @* Публічний стан поточного раунду *@
        <div id="roundStatusPanel" class="round-status-panel site-round-hud" style="display: none;">
            <div class="round-status-main site-hud-module module-round">
                <span class="round-status-label">Поточний раунд</span>
                <strong id="roundStatusNumber">Раунд 1</strong>
            </div>

            <div class="round-status-details site-hud-module module-phase">
                <span id="roundStatusPhase">Розкриття характеристик</span>
                <span id="roundStatusProgress">0/0 відкрили</span>
                <span id="roundDiceResult" class="round-dice-result" style="display: none;"></span>
            </div>

            <div id="publicGameTimer" class="public-game-timer site-hud-module module-timer">
                <strong id="publicGameTimerValue">05:00</strong>
                <span id="publicGameTimerStatus">Зупинено</span>
                <small id="publicGameTimerLabel"></small>
            </div>
        </div>

        <section id="gameFinishedPanel"
                 class="game-finished-panel"
                 style="display: none;"
                 aria-labelledby="gameFinishedTitle"
                 aria-live="polite">

            <div class="game-finished-heading">
                <span class="game-finished-kicker">Vault Judgment</span>
                <h2 id="gameFinishedTitle">Гру завершено</h2>
                <p id="gameFinishedReason">Місткість бункера досягнута.</p>
            </div>

            <div class="game-finished-summary">
                <div><span id="gameFinishedCapacityLabel">Місткість бункера</span><strong id="gameFinishedCapacity">—</strong></div>
                <div><span id="gameFinishedSurvivorLabel">Переможців</span><strong id="gameFinishedSurvivorCount">—</strong></div>
                <div><span id="gameFinishedRoundLabel">Раунд завершення</span><strong id="gameFinishedRound">—</strong></div>
                <div><span id="gameFinishedTimeLabel">Час завершення</span><strong id="gameFinishedTime">—</strong></div>
            </div>

            <div class="game-finished-winners">
                <h3 id="gameFinishedWinnersTitle">Переможці</h3>
                <ul id="gameFinishedWinners"></ul>
            </div>

            <p id="gameFinishedWaitingForHost" class="game-finished-waiting"></p>
            <p id="gameFinishedFeedback" class="game-finished-feedback" role="status"></p>

            <div class="game-finished-actions">
                <button id="returnFinishedGameButton"
                        type="button"
                        class="btn-primary"
                        onclick="returnFinishedGameToLobby()"
                        style="display: none;">
                    Нова гра
                </button>

                <button id="copyGameSummaryButton"
                        type="button"
                        class="btn-secondary"
                        onclick="copyGameSummary()">
                    Скопіювати підсумок
                </button>
            </div>
        </section>

        @* Голосування гравців *@
        <div id="votingPanel" class="voting-panel site-panel" style="display: none;">
            <div class="voting-header">
                <h3>🗳️ Голосування (Раунд <span id="votingRound">1</span>)</h3>
                <div class="voting-progress">
                    <span id="votingProgressText">0/0 проголосували</span>
                </div>
            </div>

            <div class="voting-content">
                @* Вибір кандидата для голосування *@
                <div id="votingCandidates" class="voting-candidates"></div>

                @* Статус голосу поточного гравця *@
                <div id="myVoteStatus" class="my-vote-status" style="display: none;">
                    Ви проголосували за: <span id="myVoteTarget" class="vote-target"></span>
                </div>
            </div>

            @* Керування голосуванням для хоста *@
            <div id="votingHostControls" class="voting-host-controls" style="display: none;">
                <button type="button" class="btn-warning" onclick="endVotingEarly()">Завершити голосування</button>
                <button type="button" class="btn-secondary" onclick="cancelVoting()">Скасувати</button>
            </div>
        </div>

        @* Результати голосування та рішення хоста *@
        <div id="votingResultsPanel" class="voting-results-panel site-panel" style="display: none;">
            <div class="voting-results-header">
                <h3>📊 Результати голосування</h3>
            </div>

            <div id="votingResultsContent" class="voting-results-content"></div>

            <div id="votingDecisionControls" class="voting-decision-controls">
                <p class="decision-prompt">Оберіть дію:</p>
                <button id="eliminateTopBtn" type="button" class="btn-danger" onclick="eliminateTopVoted()">❌ Елімінувати лідера</button>
                <button type="button" class="btn-success" onclick="resolveNoElimination()">✓ Нікого не елімінувати</button>
            </div>
        </div>

        @* Перевірка готовності до голосування *@
        <div id="readyCheckPanel" class="ready-check-panel site-panel" style="display: none;">
            <div class="ready-check-header">
                <strong>Всі готові до голосування?</strong>
                <span id="readyCheckSummary">Очікуємо відповіді гравців</span>
            </div>

            <div class="ready-check-actions">
                <button type="button" onclick="submitVotingReadyStatus('ready')">Готовий</button>
                <button type="button" onclick="submitVotingReadyStatus('add')">Хочу щось додати</button>
                <button type="button" onclick="submitVotingReadyStatus('special')">Хочу використати карту</button>
            </div>
        </div>

        @* Глобальний каталог і редактор JSON-контенту *@
        <partial name="~/Views/Shared/Bunker/_GlobalContentCatalog.cshtml" />

        @* Lobby кімнати до початку гри *@
        <partial name="~/Views/Shared/Bunker/_RoomLobby.cshtml" />

        @* Приватні характеристики та спеціальні карти поточного гравця *@
        <div id="myPlayerSection" class="site-major-section" style="display:none;">
            <h2 class="section-title site-section-heading">Мої характеристики (бачу тільки я)</h2>
            <div id="myPlayerCards" class="player-cards-grid"></div>

            <section id="mySpecialCardsSection" class="my-special-cards-section">
                <h2 class="section-title site-section-heading">Мої спеціальні карти</h2>
                <div id="mySpecialCardsList" class="my-special-cards-list"></div>
            </section>

            <section id="myEventCardsSection" class="my-special-cards-section" hidden>
                <h2 class="section-title site-section-heading">Подієві карти</h2>
                <div id="myEventCardsList" class="my-special-cards-list"></div>
            </section>
        </div>

        @* Основне ігрове поле після початку гри *@
        <partial name="~/Views/Shared/Bunker/_GameBoard.cshtml" />

        @* Журнал ігрових подій поточної кімнати *@
        <partial name="~/Views/Shared/Bunker/_EventsPanel.cshtml" />
    </div>
</div>

@* Панель керування грою рендериться на верхньому рівні, щоб fixed drawer не залежав від game container. *@
<partial name="~/Views/Shared/Bunker/_GmPanel.cshtml" />

<div id="scenarioPublicModal"
     class="modal scenario-situation-modal"
     hidden
     role="dialog"
     aria-modal="true"
     aria-labelledby="scenarioPublicTitle">

    <div class="modal-content">
        <span id="scenarioPublicType" class="scenario-situation-badge">Подія</span>
        <h3 id="scenarioPublicTitle"></h3>
        <p id="scenarioPublicText"></p>

        <div class="modal-actions">
            <button type="button" class="btn-primary" onclick="closeScenarioPublicModal()">Продовжити</button>
        </div>
    </div>
</div>

<div id="scenarioPrivateModal"
     class="modal scenario-situation-modal"
     hidden
     role="dialog"
     aria-modal="true"
     aria-labelledby="scenarioPrivateTitle">

    <div class="modal-content">
        <span id="scenarioPrivateType" class="scenario-situation-badge scenario-situation-badge-private">Таємна подія</span>
        <h3 id="scenarioPrivateTitle">Приватна подія</h3>
        <p id="scenarioPrivateMessage"></p>
        <div id="scenarioPrivateCard"></div>
        <div id="scenarioPrivateChoices"></div>
        <p id="scenarioPrivateExpiry"></p>

        <div class="modal-actions">
            <button type="button" class="btn-secondary" onclick="closeScenarioPrivateModal()">Закрити</button>
        </div>
    </div>
</div>

@* Підтвердження примусового завершення загрози для GM *@
<div id="gmThreatForceModal"
     class="modal gm-threat-force-modal"
     style="display: none;"
     role="dialog"
     aria-modal="true"
     aria-labelledby="gmThreatForceTitle">

    <div class="modal-content">
        <h3 id="gmThreatForceTitle" data-gm-i18n="gmThreatForcePreviewTitle">Підтвердження примусового завершення</h3>
        <div id="gmThreatForcePreviewContent"></div>
        <p id="gmThreatForceError" class="gm-threat-force-error" aria-live="polite"></p>

        <div class="modal-actions">
            <button type="button" class="btn-secondary" data-gm-i18n="cancel" onclick="closeGMThreatForceModal()">Скасувати</button>
            <button type="button" id="gmThreatForceRefresh" class="btn-secondary" data-gm-i18n="gmThreatForceRefresh" onclick="refreshGMThreatForcePreview()" style="display: none;">Оновити preview</button>
            <button type="button" id="gmThreatForceConfirm" class="btn-primary" data-gm-i18n="confirm" onclick="confirmGMThreatForce()">Підтвердити</button>
        </div>
    </div>
</div>

@* Приєднання до вибраної кімнати *@
<div id="joinModal"
     class="modal"
     style="display: none;"
     role="dialog"
     aria-modal="true"
     aria-labelledby="joinModalTitle">

    <div class="modal-content">
        <h3 id="joinModalTitle">Приєднатися до кімнати</h3>

        <div>
            <label class="visually-hidden" for="playerNameJoin">Ім'я гравця</label>
            <input id="playerNameJoin"
                   name="playerNameJoin"
                   type="text"
                   class="input-field"
                   placeholder="Ваше ім'я..."
                   maxlength="10"
                   autocomplete="nickname"
                   oninput="sanitizeNameInput(this)" />

            <label class="visually-hidden" for="joinRoomPassword">Пароль кімнати</label>
            <input id="joinRoomPassword"
                   name="joinRoomPassword"
                   type="password"
                   class="input-field"
                   placeholder="Пароль (якщо є)"
                   autocomplete="current-password" />

            <input type="hidden" id="joinRoomId" name="joinRoomId" />

            <div class="modal-actions">
                <button type="button" class="btn-secondary" onclick="closeJoinModal()">Скасувати</button>
                <button type="button" class="btn-primary" onclick="submitJoinRoom()">Приєднатися</button>
            </div>
        </div>
    </div>
</div>

@* Редагування характеристики гравця *@
<div id="editCharModal"
     class="modal"
     style="display: none;"
     role="dialog"
     aria-modal="true"
     aria-labelledby="editCharModalTitle">

    <div class="modal-content">
        <h3 id="editCharModalTitle">Редагувати характеристику</h3>
        <p id="editCharInfo" class="edit-char-info"></p>

        <div>
            <label class="visually-hidden" for="editCharValue">Нове значення характеристики</label>
            <input id="editCharValue"
                   name="editCharValue"
                   type="text"
                   class="input-field"
                   placeholder="Нове значення..."
                   autocomplete="off" />

            <input type="hidden" id="editCharName" name="editCharName" />

            <div class="modal-actions">
                <button type="button" class="btn-secondary" onclick="closeEditCharModal()">Скасувати</button>
                <button type="button" class="btn-warning" onclick="clearCharacteristic()">Очистити</button>
                <button type="button" class="btn-primary" onclick="submitEditCharacteristic()">Зберегти</button>
            </div>
        </div>
    </div>
</div>

@* Перегляд прихованої характеристики для хоста *@
<div id="peekModal"
     class="modal"
     style="display: none;"
     role="dialog"
     aria-modal="true"
     aria-labelledby="peekModalTitle">

    <div class="modal-content modal-peek">
        <h3 id="peekModalTitle">&#128065; Підгляд характеристики</h3>
        <div id="peekModalContent"></div>

        <div class="modal-actions">
            <button type="button" class="btn-primary" onclick="closePeekModal()">Закрити</button>
        </div>
    </div>
</div>

<script src="~/js/signalr-lite.js" asp-append-version="true"></script>
<script src="~/js/game.js" asp-append-version="true"></script>
<script src="~/js/bunker/gm-panel-v2.js" asp-append-version="true"></script>
<script src="~/js/bunker/development-images.js" asp-append-version="true"></script>
