@{ ViewData["Title"] = "AI Training Arena"; var initialArenaId = ViewData["InitialArenaId"] as string; }
<link rel="stylesheet" href="~/css/ai-arena.css" asp-append-version="true" />
<section id="aiArena" class="ai-arena-shell" data-initial-arena-id="@initialArenaId">
    <header class="ai-arena-topbar">
        <div><span class="ai-arena-kicker">Developer spectator</span><h1>AI Training Arena</h1><p id="arenaStatus" class="ai-arena-status" role="status">Підключення…</p></div>
        <div class="ai-arena-actions">
            <button id="arenaCreate" type="button">Нова арена</button><button id="arenaStart" type="button" disabled>Запустити</button><button id="arenaPause" type="button" disabled>Пауза</button><button id="arenaResume" type="button" disabled>Продовжити</button><button id="arenaStep" type="button" disabled>Один крок</button><button id="arenaCancel" type="button" class="danger" disabled>Завершити</button>
        </div>
    </header>

    <section class="ai-arena-configuration" aria-label="Налаштування AI арени">
        <label>Провайдер <select id="arenaProvider"><option value="Deterministic">Deterministic</option><option value="Local">Local MamayLM</option><option value="Gemini">Gemini</option><option value="Groq">Groq</option><option value="OpenRouter">OpenRouter</option></select></label>
        <label>Режим <select id="arenaGenerationMode"><option value="Direct">Direct</option><option value="Strategic">Strategic</option></select></label>
        <span>Модель <b id="arenaModel">—</b></span><span>Local <b id="arenaProviderStatus">не перевірено</b></span>
        <button id="arenaCheckProvider" type="button">Перевірити з’єднання</button><a id="arenaExport" class="arena-export" hidden>Експортувати dataset (.zip)</a>
    </section>

    <section id="arenaSummary" class="ai-arena-summary" aria-label="Стан арени"></section>
    <section id="arenaScenario" class="ai-arena-panel arena-scenario-panel" aria-label="Сценарій виживання"></section>

    <div class="ai-arena-dashboard">
        <aside class="ai-arena-panel arena-players-panel">
            <div class="panel-heading"><div><span>Учасники</span><h2>Шість AI</h2></div><span id="arenaPlayerCount" class="panel-count"></span></div>
            <div id="arenaAgents" class="arena-agent-list"></div>
            <details class="arena-sessions"><summary>Збережені сесії</summary><div id="arenaSessions"></div></details>
        </aside>

        <main class="ai-arena-main">
            <section class="ai-arena-panel arena-chat-panel"><div class="panel-heading"><div><span>Жива дискусія</span><h2>Публічний чат</h2></div></div><div id="arenaChat" class="ai-arena-chat" aria-live="polite"></div></section>
            <section class="ai-arena-panel arena-events-panel"><div class="panel-heading"><div><span>Події</span><h2>Історія гри</h2></div></div><div id="arenaEvents" class="ai-arena-events"></div></section>
        </main>

        <aside class="ai-arena-side">
            <section class="ai-arena-panel arena-voting-panel"><div class="panel-heading"><div><span>Голосування</span><h2>Рішення та вибуття</h2></div></div><div id="arenaVotingEvents" class="ai-arena-events"></div></section>
            <section class="ai-arena-panel arena-diagnostics"><div class="panel-heading"><div><span>Developer diagnostics</span><h2>Генерація та помилки</h2></div></div><div id="arenaDiagnostics">Помилок генерації ще немає.</div></section>
            <section class="ai-arena-panel arena-technical-panel"><div class="panel-heading"><div><span>Технічні події</span><h2>Стан симулятора</h2></div></div><div id="arenaTechnicalEvents" class="ai-arena-events"></div></section>
            <details class="ai-arena-panel arena-debug"><summary>Приватний developer-debug</summary><div id="arenaDebug">Оберіть AI, щоб побачити останнє рішення.</div></details>
        </aside>
    </div>
</section>

<div id="arenaDetailBackdrop" class="arena-detail-backdrop" hidden></div>
<aside id="arenaDetailDrawer" class="arena-detail-drawer" role="dialog" aria-modal="true" aria-label="Деталі developer spectator" aria-hidden="true" hidden>
    <header><div><span id="arenaDrawerMeta" class="ai-arena-kicker"></span><h2 id="arenaDrawerTitle">Деталі</h2></div><button id="arenaDrawerClose" type="button" aria-label="Закрити деталі">×</button></header>
    <div id="arenaDrawerContent" class="arena-drawer-content"></div>
</aside>
<div id="arenaTooltip" class="arena-tooltip" role="tooltip" hidden></div>

<script src="~/js/signalr-lite.js" asp-append-version="true"></script>
<script src="~/js/ai-arena.js" asp-append-version="true"></script>
