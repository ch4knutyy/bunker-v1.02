@{
    Layout = null;
    var language = Context.Request.Headers.AcceptLanguage.ToString().ToLowerInvariant();
    var locale = language.StartsWith("ru", StringComparison.Ordinal) ? "ru" :
                 language.StartsWith("en", StringComparison.Ordinal) ? "en" : "uk";
    string T(string uk, string ru, string en) => locale switch { "ru" => ru, "en" => en, _ => uk };
}
<!doctype html>
<html lang="@locale">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>Vault Judgment — Private Alpha</title>
    <style>
        :root { color-scheme: dark; font-family: system-ui,-apple-system,Segoe UI,sans-serif; }
        * { box-sizing: border-box; }
        body { min-height: 100vh; display: grid; place-items: center; margin: 0; padding: 24px; color: #e9edf7; background: radial-gradient(ellipse at 50% 5%, #233047, #0d121e 65%); }
        main { width: min(100%, 420px); border: 1px solid #344056; background: #131b2b; border-radius: 18px; padding: 36px; box-shadow: 0 22px 75px #050a14bb; }
        .brand { font-size: 27px; font-weight: 800; letter-spacing: .14em; line-height: 1.2; }
        .eyebrow { margin: 9px 0 28px; color: #9cadc8; letter-spacing: .22em; font-size: 12px; }
        h1 { font-size: 21px; margin: 0 0 10px; }
        p { color: #abb9d0; line-height: 1.55; }
        label { display: block; margin: 26px 0 8px; font-size: 14px; }
        input { width: 100%; padding: 13px 14px; border-radius: 9px; border: 1px solid #4c5b72; background: #0c1320; color: #fff; font-size: 16px; }
        input:focus-visible { outline: 2px solid #a6bafa; outline-offset: 2px; }
        button { margin-top: 17px; width: 100%; padding: 13px; background: #d3dcf0; color: #131b2b; border: 0; border-radius: 9px; font-size: 15px; font-weight: 750; cursor: pointer; }
        button:hover { background: #fff; }
        .error { color: #ffacae; font-size: 14px; }
        small { display: block; margin-top: 22px; color: #8d9db8; }
    </style>
</head>
<body>
<main>
    <div class="brand">VAULT JUDGMENT</div>
    <div class="eyebrow">PRIVATE ALPHA</div>
    <h1>@T("Закритий доступ", "Закрытый доступ", "Private access")</h1>
    <p>@T("Сайт перебуває в розробці. Введіть пароль, отриманий від розробника.", "Сайт находится в разработке. Введите пароль, полученный от разработчика.", "This site is in development. Enter the access password provided by the developer.")</p>
    <form action="/alpha-access" method="post">
        @Html.AntiForgeryToken()
        <label for="password">@T("Пароль доступу", "Пароль доступа", "Access password")</label>
        <input type="password" name="password" id="password" maxlength="256" required autocomplete="current-password" autofocus>
        @if (ViewData["InvalidPassword"] is true)
        {
            <p class="error" role="alert">@T("Неправильний пароль. Спробуйте ще раз.", "Неверный пароль. Попробуйте ещё раз.", "Incorrect password. Please try again.")</p>
        }
        <button type="submit">@T("Увійти", "Войти", "Enter")</button>
    </form>
    <small>@T("Доступ зберігається в браузері до 7 днів.", "Доступ сохраняется в браузере до 7 дней.", "Access is remembered in this browser for up to 7 days.")</small>
</main>
</body>
</html>
