@model IReadOnlyList<Bunker.Models.Academy.Subject>
@{
    ViewData["Title"] = "Academy";
}

<section class="mode-page">
    <div class="mode-page-header"><h1 data-i18n="academySubjects">Предмети</h1></div>
    <div class="mode-grid">
        @foreach (var subject in Model)
        {
            <article class="mode-card">
                <h2>@subject.Name</h2>
                <p data-i18n="academySubject@(subject.Id)Description">@subject.Description</p>
                <a class="mode-action" asp-controller="Academy" asp-action="SubjectDetails" asp-route-id="@subject.Id" data-i18n="academyDetails">Детальніше</a>
            </article>
        }
    </div>
    <a class="mode-action" asp-controller="Academy" asp-action="Index" data-i18n="academyBack">До академічної групи</a>
</section>
