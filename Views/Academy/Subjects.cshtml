@model IReadOnlyList<Bunker.Models.Academy.Subject>
@{
    ViewData["Title"] = "Academy";
}

<link rel="stylesheet" href="~/css/academy.css" asp-append-version="true" />

<section class="mode-page academy-page">
    <div class="mode-page-header"><h1 data-i18n="academySubjects">Предмети</h1></div>
    <div class="academy-subject-grid">
        @foreach (var subject in Model)
        {
            <partial name="_AcademySubjectCard" model="subject" />
        }
    </div>
    <a class="mode-action" asp-controller="Academy" asp-action="Index" data-i18n="academyBack">До академічної групи</a>
</section>
