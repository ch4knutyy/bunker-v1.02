@model IReadOnlyList<Bunker.Models.Academy.Student>
@{
    ViewData["Title"] = "Academy";
}

<section class="mode-page">
    <div class="mode-page-header"><h1 data-i18n="academyStudents">Студенти</h1></div>
    <div class="mode-grid">
        @foreach (var student in Model)
        {
            <partial name="_AcademyStudentCard" model="student" />
        }
    </div>
    <a class="mode-action" asp-controller="Academy" asp-action="Index" data-i18n="academyBack">До академічної групи</a>
</section>
