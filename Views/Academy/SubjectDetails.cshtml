@model Bunker.Models.Academy.Subject
@{
    ViewData["Title"] = Model.Name;
}

<link rel="stylesheet" href="~/css/academy.css" asp-append-version="true" />

<section class="mode-page academy-page">
    <article class="academy-profile">
        <h1>@Model.Name</h1>
        <dl class="academy-subject-facts">
            <div>
                <dt data-i18n="academyTeacher">Викладач</dt><dd>@Model.Teacher</dd>
            </div>
            <div>
                <dt data-i18n="academyHours">Навчальні години</dt><dd>@Model.Hours</dd>
            </div>
        </dl>
        <section class="academy-interests">
            <h2 data-i18n="academySubjectDescription">Опис</h2>
            <p data-i18n="academySubject@(Model.Id)Description">@Model.Description</p>
        </section>
    </article>
    <nav class="academy-actions">
        <a class="mode-action" asp-controller="Academy" asp-action="Subjects" data-i18n="academyBackSubjects">До списку предметів</a>
        <a class="mode-action" asp-controller="Academy" asp-action="Index" data-i18n="academyBack">До академічної групи</a>
    </nav>
</section>
