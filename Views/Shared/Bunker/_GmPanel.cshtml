@*
    Панель Game Master.

    Містить керування станом гри, раундами, загрозами,
    гравцями, діагностикою, audit, snapshots та undo.

    Приховування елементів інтерфейсу не є перевіркою прав:
    доступ до команд повинен перевірятися на backend.
*@
<div id="gmPanelBackdrop"
	 class="gm-panel-v2-backdrop"
	 aria-hidden="true"
	 data-gm-click="toggleGMPanel()"></div>
<aside id="gmPanel"
	   class="gm-panel-v2-drawer"
	   role="dialog"
	   aria-modal="true"
	   aria-hidden="true"
	   aria-labelledby="gmPanelTitle">
	<div class="gm-panel-v2-header">
		<div>
			<h3 id="gmPanelTitle" data-gm-i18n="gmPanelTitle">Панель ведучого</h3>
			<div class="gm-panel-identity">
				<span id="gmPanelRoleBadge" class="gm-status-badge">Host</span>
				<span id="gmPanelRoomCode">—</span>
				<span id="gmPanelConnectionStatus" class="gm-panel-connection">Синхронізовано</span>
			</div>
		</div>
		<button type="button" class="btn-close" aria-label="Закрити панель ведучого" data-gm-i18n-aria-label="gmClosePanel" data-gm-click="toggleGMPanel()">×</button>
	</div>
	<nav class="gm-panel-v2-tabs" aria-label="GM sections">
		<button type="button" class="gm-tab active" role="tab" aria-selected="true" data-gm-tab-button="game" data-gm-i18n="gmTabGame" hidden>Гра</button>
		<button type="button" class="gm-tab" role="tab" aria-selected="false" data-gm-tab-button="players" data-gm-i18n="gmTabPlayers" hidden>Гравці</button>
		<button type="button" class="gm-tab" role="tab" aria-selected="false" data-gm-tab-button="events" data-gm-i18n="gmTabEvents" hidden>Події</button>
		<button type="button" class="gm-tab" role="tab" aria-selected="false" data-gm-tab-button="history" data-gm-i18n="gmTabHistory" hidden>Історія</button>
		<button type="button" class="gm-tab" role="tab" aria-selected="false" data-gm-tab-button="tools" data-gm-i18n="gmTabTools" hidden>Інструменти</button>
		<button type="button" class="gm-tab" role="tab" aria-selected="false" data-gm-tab-button="diagnostics" data-gm-i18n="gmTabDiagnostics" hidden>Діагностика</button>
		<button type="button" class="gm-tab" role="tab" aria-selected="false" data-gm-tab-button="recovery" data-gm-i18n="gmTabRecovery" hidden>Відновлення</button>
		<button id="omniscientHiddenTab" type="button" class="gm-tab" role="tab" aria-selected="false" data-gm-tab-button="overview" data-gm-i18n="gmTabOverview" hidden>Огляд</button>
	</nav>
	<div class="gm-panel-v2-content">
		<section id="gmRecommendedAction" class="gm-recommended-action" aria-live="polite">
			<span data-gm-i18n="gmPrimaryActionLabel">Рекомендована дія</span>
			<strong id="gmRecommendedActionText">Очікуйте синхронізації стану кімнати</strong>
			<button id="gmPrimaryActionButton" type="button" class="btn-gm-action gm-action-primary" hidden></button>
		</section>
		<div id="gmPanelV2LoadState" class="gm-panel-v2-load-state" role="status" aria-live="polite">
			<p id="gmPanelV2LoadMessage" data-gm-i18n="gmPanelLoading">Завантаження панелі ведучого…</p>
			<button id="gmPanelV2Retry"
					type="button"
					class="btn-gm-action"
					data-gm-panel-action="retry"
					data-gm-i18n="gmRetry"
					hidden>
				Повторити
			</button>
		</div>
		<div class="gm-section" id="gmGameStateSection" data-gm-tab="game" style="display: none;">
			<h4 class="gm-section-title" data-gm-i18n="gmGameState">Стан гри</h4>
			<div id="gmGameStateSummary" class="gm-status-grid"></div>
		</div>
		<div class="gm-section gm-accordion" id="gmScenarioSection" data-gm-tab="events" data-gm-accordion style="display: none;">
			<button id="gmScenarioToggle" type="button" class="gm-accordion-toggle" aria-expanded="false" aria-controls="gmScenarioPanel">
				<span data-gm-i18n="gmScenarioSituations">Сценарні ситуації</span>
				<span class="gm-accordion-arrow" aria-hidden="true">⌄</span>
			</button>
			<div id="gmScenarioPanel" class="gm-accordion-panel" role="region" aria-labelledby="gmScenarioToggle" hidden>
			<div id="gmScenarioSummary" class="gm-status-grid"></div>
			<div class="gm-round-actions">
				<button type="button" class="btn-gm-action" data-gm-i18n="gmSkipPendingChoice" data-gm-click="gmSkipScenarioChoice()">Пропустити поточний вибір</button>
			</div>
			<p class="gm-round-hint" data-gm-i18n="gmScenarioPrivacyHint">Приватний власник карти не показується звичайному ведучому.</p>
			</div>
		</div>

		<div class="gm-section gm-round-section" id="gmRoundSection" data-gm-tab="game" style="display: none;">
			<section class="gm-accordion" data-gm-accordion>
				<button id="gmRoundOperationsToggle"
						type="button"
						class="gm-accordion-toggle"
						aria-expanded="false"
						aria-controls="gmRoundOperationsPanel">
					<span data-gm-i18n="gmRoundOperations">Керування раундом</span>
					<span class="gm-accordion-arrow" aria-hidden="true">⌄</span>
				</button>
				<div id="gmRoundOperationsPanel" class="gm-accordion-panel" role="region" aria-labelledby="gmRoundOperationsToggle" hidden>
			<section class="gm-round-control-block gm-round-state-block" aria-labelledby="gmRoundStateHeading">
				<h5 id="gmRoundStateHeading" data-gm-i18n="gmRoundCurrentState">Поточний стан</h5>
				<div class="gm-round-summary">
					<span id="gmCurrentRound">Раунд 1</span>
					<strong id="gmCurrentPhase">Розкриття характеристик</strong>
					<small id="gmRoundProgress">0/0 відкрили</small>
					<small id="gmDiceResult" class="gm-dice-result" style="display: none;"></small>
					<span id="gmPauseBadge" class="gm-status-badge">Гра триває</span>
					<small id="gmPauseReasonSummary" class="gm-pause-reason-summary" style="display: none;"></small>
				</div>
			</section>
			<section class="gm-round-control-block" aria-labelledby="gmRoundMainHeading">
				<h5 id="gmRoundMainHeading" data-gm-i18n="gmRoundMainActions">Основні дії</h5>
				<label class="gm-label" for="gmPauseReason" data-gm-i18n="gmPauseReason">Причина паузи</label>
				<input id="gmPauseReason" class="gm-select" maxlength="160" />
				<div class="gm-round-actions">
					<button class="btn-gm-action gm-round-command gm-action-secondary" data-gm-i18n="gmPause" data-gm-click="setGamePause(true)">Пауза</button>
					<button class="btn-gm-action gm-round-command gm-action-secondary" data-gm-i18n="gmResume" data-gm-click="setGamePause(false)">Продовжити</button>
				</div>
				<div class="gm-round-actions gm-round-main-actions">
					<button id="rollDiceBtn" class="btn-gm-action" data-gm-click="rollRoundDice()" disabled>Кинути кубик</button>
					<button id="endRoundBtn" class="btn-gm-action gm-action-secondary" data-gm-i18n="gmEndRoundAction" data-gm-click="endRound()" disabled>Перейти до наступного етапу</button>
					<button id="startReadyCheckBtn" class="btn-gm-action" data-gm-i18n="gmMarkAllReadyAction" data-gm-click="markAllPlayersReady()" disabled>Позначити всіх готовими</button>
					<button id="gmStartVotingBtn" class="btn-gm-action" data-gm-i18n="gmStartVotingAction" data-gm-click="startVoting()" style="display: none;">Почати голосування</button>
				</div>
				<p id="gmVotingLockedHint" class="gm-round-hint" data-gm-i18n="gmVotingRevealRequirementHint">Голосування можна почати після виконання вимоги розкриття.</p>
				<div id="gmReadyStatusList" class="gm-ready-status-list" style="display: none;"></div>
				<div id="gmSpecialCardsList" class="gm-special-cards-list" style="display: none;"></div>
			</section>
			<section class="gm-round-control-block" data-gm-requires-capability="CanUseTechnicalTools" aria-labelledby="gmManualRoundHeading">
				<h5 id="gmManualRoundHeading" data-gm-i18n="gmManualRoundHeading">Ручне встановлення раунду</h5>
				<p class="gm-round-hint" data-gm-i18n="gmManualRoundHint">Перехід можливий лише вперед; частину стану поточного раунду буде очищено.</p>
				<div class="gm-round-form-row">
					<label class="gm-field" for="gmManualRound">
						<span data-gm-i18n="gmManualRound">Номер раунду</span>
						<input id="gmManualRound" class="gm-select" type="number" min="1" max="99" step="1" />
					</label>
					<button class="btn-gm-action gm-round-command gm-action-secondary" data-gm-i18n="gmPreviewRound" data-gm-click="previewManualRoundChange()">Preview / підтвердити</button>
				</div>
			</section>
			<section class="gm-round-control-block gm-round-danger-zone" aria-labelledby="gmReadinessHeading">
				<h5 id="gmReadinessHeading" data-gm-i18n="gmReadinessHeading">Скидання готовності</h5>
				<p class="gm-round-hint" data-gm-i18n="gmReadinessHint">Очищає поточні позначки готовності після підтвердження.</p>
				<button class="btn-gm-action btn-danger gm-round-command" data-gm-i18n="gmResetReadiness" data-gm-click="resetRoundReadiness()">Скинути готовність</button>
			</section>
				</div>
			</section>
			<section class="gm-accordion" id="gmGameTimerCard" data-gm-accordion>
				<button id="gmTimerOperationsToggle"
						type="button"
						class="gm-accordion-toggle"
						aria-expanded="false"
						aria-controls="gmTimerOperationsPanel">
					<span data-gm-i18n="gmTimerOperations">Керування таймером</span>
					<span class="gm-accordion-arrow" aria-hidden="true">⌄</span>
				</button>
				<div id="gmTimerOperationsPanel" class="gm-accordion-panel gm-timer-block" role="region" aria-labelledby="gmTimerOperationsToggle" hidden>
				<div class="gm-timer-fields">
					<label class="gm-field" for="gmTimerMinutes"><span data-gm-i18n="gmTimerMinutes">Хвилини</span><input id="gmTimerMinutes" class="gm-select" type="number" min="0" max="120" step="1" value="5" /></label>
					<label class="gm-field" for="gmTimerSeconds"><span data-gm-i18n="gmTimerSeconds">Секунди</span><input id="gmTimerSeconds" class="gm-select" type="number" min="0" max="59" step="1" value="0" onkeydown="handleGameTimerKeydown(event)" /></label>
					<label class="gm-field" for="gmTimerPurpose">
						<span data-gm-i18n="gmTimerPurpose">Призначення</span>
						<select id="gmTimerPurpose" class="gm-select">
							<option value="Round" data-gm-i18n="timerPurposeRound">Раунд</option>
							<option value="Voting" data-gm-i18n="timerPurposeVoting">Голосування</option>
							<option value="Threat" data-gm-i18n="timerPurposeThreat">Загроза</option>
							<option value="Custom" data-gm-i18n="timerPurposeCustom">Інше</option>
						</select>
					</label>
					<label class="gm-field" for="gmTimerLabel"><span data-gm-i18n="gmTimerName">Назва</span><input id="gmTimerLabel" class="gm-select" maxlength="80" data-gm-i18n-placeholder="gmTimerLabel" placeholder="Label" /></label>
				</div>
				<div class="gm-round-actions">
					<button id="gmTimerStart" class="btn-gm-action gm-timer-command gm-action-secondary" data-gm-i18n="gmTimerStartAction" data-gm-click="startGameTimer()">Запустити таймер</button>
					<button id="gmTimerPause" class="btn-gm-action gm-timer-command" data-gm-i18n="gmTimerPauseAction" data-gm-click="invokeGameTimerCommand('PauseGameTimer')">Призупинити таймер</button>
					<button id="gmTimerResume" class="btn-gm-action gm-timer-command" data-gm-i18n="gmTimerResumeAction" data-gm-click="invokeGameTimerCommand('ResumeGameTimer')">Продовжити таймер</button>
					<button id="gmTimerRestart" class="btn-gm-action gm-timer-command" data-gm-i18n="gmTimerRestartAction" data-gm-click="restartGameTimer()">Перезапустити таймер</button>
					<button class="btn-gm-action gm-timer-command" data-gm-click="adjustGameTimer(30)">+30 сек</button>
					<button class="btn-gm-action gm-timer-command" data-gm-click="adjustGameTimer(-30)">−30 сек</button>
					<button class="btn-gm-action gm-timer-command" data-gm-i18n="gmTimerSetAction" data-gm-click="setGameTimer()">Встановити час таймера</button>
					<button id="gmTimerStop" class="btn-gm-action btn-danger gm-timer-command" data-gm-i18n="gmTimerStopAction" data-gm-click="stopGameTimer()">Зупинити таймер</button>
				</div>
				<p id="gmTimerFeedback" class="gm-round-hint" aria-live="polite"></p>
				</div>
			</section>
			<section class="gm-accordion" data-gm-accordion data-gm-requires-capability="CanUseTechnicalTools">
				<button id="gmVotingRecoveryToggle" type="button" class="gm-accordion-toggle" aria-expanded="false" aria-controls="gmVotingRecoveryPanel">
					<span data-gm-i18n="gmVotingRecovery">Відновлення голосування</span>
					<span class="gm-accordion-arrow" aria-hidden="true">⌄</span>
				</button>
				<div id="gmVotingRecoveryPanel" class="gm-accordion-panel gm-voting-admin-card" role="region" aria-labelledby="gmVotingRecoveryToggle" hidden>
				<h5 data-gm-i18n="gmVotingRecovery">Відновлення голосування</h5>
				<div class="gm-round-actions">
					<button class="btn-gm-action gm-round-command" data-gm-i18n="gmClearVotes" data-gm-click="clearCurrentVotes()">Очистити голоси</button>
					<button class="btn-gm-action gm-round-command" data-gm-i18n="gmVotingResync" data-gm-click="resyncVotingAdmin()">Синхронізувати</button>
				</div>
				<select id="gmRemoveVoterSelect" class="gm-select"></select>
				<button class="btn-gm-action gm-round-command" data-gm-i18n="gmRemoveVote" data-gm-click="removeSelectedVote()">Видалити голос voter</button>
				<div id="gmNonVotersList" class="gm-ready-status-list"></div>
				</div>
			</section>
			<details class="gm-player-danger" data-gm-requires-capability="CanUseTechnicalTools">
				<summary data-gm-i18n="gmUnavailableRecovery">Недоступні recovery controls</summary>
				<button class="btn-gm-action" disabled data-gm-i18n="gmStageUnavailable">Reopen/skip потребує transition helper</button>
			</details>
			<p id="gmRoundCommandResult" class="gm-round-hint" aria-live="polite"></p>
		</div>

		<section class="gm-section gm-accordion" id="gmVotingV2Section" data-gm-tab="game" data-gm-accordion style="display: none;">
			<button id="gmVotingOperationsToggle" type="button" class="gm-accordion-toggle" aria-expanded="false" aria-controls="gmVotingOperationsPanel">
				<span data-gm-i18n="gmVotingOperations">Керування голосуванням</span>
				<span class="gm-accordion-arrow" aria-hidden="true">⌄</span>
			</button>
			<div id="gmVotingOperationsPanel" class="gm-accordion-panel" role="region" aria-labelledby="gmVotingOperationsToggle" hidden>
			<div id="gmVotingV2Summary" class="gm-status-grid"></div>
			<p id="gmVotingV2Hint" class="gm-round-hint" data-gm-i18n="gmVotingAvailabilityHint">Доступність голосування визначає поточний стан гри.</p>
			<div class="gm-round-actions">
				<button id="gmVotingStartButton" type="button" class="btn-gm-action gm-round-command" data-gm-i18n="gmStartVotingAction" data-gm-click="startVoting()">Почати голосування</button>
				<button id="gmEndVotingBtn" type="button" class="btn-gm-action gm-round-command" data-gm-i18n="gmEndVotingAction" data-voting-action="end">Завершити голосування</button>
				<button id="gmVotingCancelButton" type="button" class="btn-gm-action btn-danger gm-round-command" data-gm-i18n="gmCancelVotingAction" data-gm-click="cancelVoting()">Скасувати голосування</button>
			</div>
			<div id="gmVotingV2NonVoters" class="gm-ready-status-list"></div>
			</div>
		</section>

		<div class="gm-section" id="gmThreatControlSection" data-gm-tab="events" style="display: none;">
			<h4 class="gm-section-title" data-gm-i18n="gmActiveThreat">Активна загроза</h4>
			<div class="gm-threat-status-card">
				<div id="gmThreatCurrent" class="gm-threat-current" data-gm-i18n="gmThreatNone">Поточна загроза відсутня</div>
				<button id="gmThreatPrimaryAction"
						type="button"
						class="btn-gm-action gm-action-primary"
						data-gm-panel-action="open-threat-controls"
						data-gm-i18n="gmThreatManage"
						hidden>
					Керувати загрозою
				</button>
			</div>
			<section id="gmThreatOperations" class="gm-accordion" data-gm-accordion>
				<button id="gmThreatOperationsToggle" type="button" class="gm-accordion-toggle" aria-expanded="false" aria-controls="gmThreatOperationsPanel">
					<span data-gm-i18n="gmThreatOperations">Загроза</span>
					<span class="gm-accordion-arrow" aria-hidden="true">⌄</span>
				</button>
				<div id="gmThreatOperationsPanel" class="gm-accordion-panel" role="region" aria-labelledby="gmThreatOperationsToggle" hidden>
					<div id="gmSpecificThreatControls" style="display: none;">
						<input id="gmThreatSearch" class="gm-select" type="search" data-gm-i18n-placeholder="gmThreatSearch" placeholder="Пошук загрози..." oninput="filterGMThreatOptions()" />
						<select id="gmThreatSelect" class="gm-select"></select>
						<button class="btn-gm-action" data-gm-i18n="gmThreatSelect" data-gm-click="gmSelectSpecificThreat()">Вибрати конкретну загрозу</button>
					</div>
					<div class="gm-round-actions">
						<button class="btn-gm-action" data-gm-i18n="gmThreatGenerateRare" data-gm-click="gmGenerateRareThreat()">Згенерувати випадкову рідкісну</button>
						<button class="btn-gm-action" data-gm-i18n="gmThreatGenerateText" data-gm-click="gmGenerateTextThreat()">Згенерувати звичайну текстову</button>
					</div>
				</div>
			</section>
			<section id="gmThreatEmergencyBlock" class="gm-accordion gm-threat-danger-zone" data-gm-accordion hidden>
				<button id="gmThreatEmergencyToggle" type="button" class="gm-accordion-toggle" aria-expanded="false" aria-controls="gmThreatEmergencyPanel">
					<span data-gm-i18n="gmThreatEmergency">Аварійне керування</span>
					<span class="gm-accordion-arrow" aria-hidden="true">⌄</span>
				</button>
				<div id="gmThreatEmergencyPanel" class="gm-accordion-panel" role="region" aria-labelledby="gmThreatEmergencyToggle" hidden>
				<button id="gmThreatResync" class="btn-gm-action" data-gm-i18n="gmThreatResync" data-gm-click="gmResyncThreatRoom()">Оновити стан загрози</button>
				<button id="gmThreatReset" class="btn-gm-action btn-danger" data-gm-i18n="gmThreatReset" data-gm-click="gmRestartThreat()">Перезапустити спробу</button>
				<button id="gmThreatAbort" class="btn-gm-action btn-danger" data-gm-i18n="gmThreatAbort" data-gm-click="gmCancelThreat()">Скасувати загрозу</button>
				<button id="gmThreatForceSuccess" class="btn-gm-action gm-force-success" data-gm-i18n="gmThreatForceSuccess" data-gm-click="requestGMThreatForcePreview('success')">Примусовий успіх</button>
				<button id="gmThreatForceFailure" class="btn-gm-action btn-danger" data-gm-i18n="gmThreatForceFailure" data-gm-click="requestGMThreatForcePreview('failure')">Примусовий провал</button>
				</div>
			</section>
			<p id="gmThreatCommandResult" class="gm-round-hint"></p>
		</div>

		<div id="gmPlayerCardsV2" class="gm-player-cards-v2" data-gm-tab="players" style="display: none;"></div>

		@* Вибір гравця для керування через GM-панель *@
		<div class="gm-section"
			 id="gmPlayerSelectSection"
			 data-gm-tab="players"
			 style="display: none;">

			<label class="gm-label" for="gmPlayerSelect">
				Вибрати гравця:
			</label>

			<select id="gmPlayerSelect"
					name="gmPlayerSelect"
					class="gm-select"
					onchange="loadPlayerDataForGM()">
				<option value="">-- Виберіть гравця --</option>
			</select>
		</div>

		@* Інформація та дії для вибраного гравця *@
		<div id="gmPlayerInfo"
			 class="gm-player-info"
			 data-gm-tab="players"
			 style="display: none;">

			<h4 id="gmPlayerName">Гравець</h4>

			@* Швидкі дії над вибраним гравцем *@
			<div class="gm-quick-actions">
				<button type="button"
						class="btn-gm-action btn-eliminate"
						data-gm-click="eliminateSelectedPlayer()">
					❌ Елімінувати
				</button>

				<button type="button"
						class="btn-gm-action btn-restore"
						data-gm-click="restoreSelectedPlayer()">
					✅ Повернути
				</button>
			</div>

			<p id="gmPlayerCommandResult"
			   class="gm-round-hint"
			   aria-live="polite"></p>

			<details class="gm-player-secondary">
				<summary data-gm-i18n="gmPlayerSecondaryActions">
					Додаткові дії
				</summary>

				<div class="gm-round-actions">
					<button type="button"
							class="btn-gm-action gm-player-command"
							data-gm-i18n="gmResyncPlayer"
							data-gm-click="resyncSelectedPlayer()">
						Синхронізувати гравця
					</button>

					<button type="button"
							class="btn-gm-action gm-player-command"
							data-gm-i18n="gmInspectConnection"
							data-gm-click="inspectSelectedConnection()">
						Перевірити connection
					</button>

					<button id="gmTransferHostButton"
							type="button"
							class="btn-gm-action gm-player-command"
							data-gm-i18n="gmTransferHost"
