@*
    Панель Game Master.

    Містить керування станом гри, раундами, загрозами,
    гравцями, діагностикою, audit, snapshots та undo.

    Приховування елементів інтерфейсу не є перевіркою прав:
    доступ до команд повинен перевірятися на backend.
*@
<div id="gmPanelBackdrop"
	 class="gm-panel-v2-backdrop"
	 aria-hidden="true"
	 onclick="toggleGMPanel()"></div>
<aside id="gmPanel"
	   class="gm-panel-v2-drawer"
	   role="dialog"
	   aria-modal="true"
	   aria-hidden="true"
	   aria-labelledby="gmPanelTitle">
	<div class="gm-panel-v2-header">
		<div>
			<h3 id="gmPanelTitle">Панель ведучого</h3>
			<div class="gm-panel-identity">
				<span id="gmPanelRoleBadge" class="gm-status-badge">Host</span>
				<span id="gmPanelRoomCode">—</span>
				<span id="gmPanelConnectionStatus" class="gm-panel-connection">Синхронізовано</span>
			</div>
		</div>
		<div class="gm-panel-mode-switch" role="group" aria-label="Режим панелі ведучого">
			<button id="gmPanelSimpleMode" type="button" class="btn-gm-action" aria-pressed="true" onclick="setGmPanelMode('simple')">Simple</button>
			<button id="gmPanelAdvancedMode" type="button" class="btn-gm-action" aria-pressed="false" onclick="setGmPanelMode('advanced')">Advanced</button>
		</div>
		<button type="button" class="btn-close" aria-label="Закрити панель ведучого" onclick="toggleGMPanel()">×</button>
	</div>
	<nav class="gm-panel-v2-tabs" aria-label="GM sections">
		<button type="button" class="gm-tab active" role="tab" aria-selected="true" data-gm-tab-button="game" onclick="switchGMTab('game')" hidden>Гра</button>
		<button type="button" class="gm-tab" role="tab" aria-selected="false" data-gm-tab-button="players" onclick="switchGMTab('players')" hidden>Гравці</button>
		<button type="button" class="gm-tab" role="tab" aria-selected="false" data-gm-tab-button="voting" onclick="switchGMTab('voting')" hidden>Голосування</button>
		<button type="button" class="gm-tab" role="tab" aria-selected="false" data-gm-tab-button="threats" onclick="switchGMTab('threats')" hidden>Загрози</button>
		<button type="button" class="gm-tab" role="tab" aria-selected="false" data-gm-tab-button="bunker" onclick="switchGMTab('bunker')" hidden>Бункер</button>
		<button type="button" class="gm-tab" role="tab" aria-selected="false" data-gm-tab-button="events" onclick="switchGMTab('events')" hidden>Події</button>
		<button type="button" class="gm-tab" role="tab" aria-selected="false" data-gm-tab-button="technical" onclick="switchGMTab('technical')" hidden>Технічне</button>
		<button id="omniscientHiddenTab" type="button" class="gm-tab" role="tab" aria-selected="false" data-gm-tab-button="overview" onclick="switchGMTab('overview')" hidden>Огляд</button>
	</nav>
	<div class="gm-panel-v2-content">
		<section id="gmRecommendedAction" class="gm-recommended-action" aria-live="polite">
			<span>Наступна рекомендована дія</span>
			<strong id="gmRecommendedActionText">Очікуйте синхронізації стану кімнати</strong>
		</section>
		<div id="gmPanelV2LoadState" class="gm-panel-v2-load-state" role="status" aria-live="polite">
			<p id="gmPanelV2LoadMessage">Завантаження панелі ведучого…</p>
			<button id="gmPanelV2Retry"
					type="button"
					class="btn-gm-action"
					onclick="retryGmPanelV2()"
					hidden>
				Повторити
			</button>
		</div>
		<div class="gm-section" id="gmGameStateSection" data-gm-tab="game" style="display: none;">
			<h4 class="gm-section-title">Стан гри</h4>
			<div id="gmGameStateSummary" class="gm-status-grid"></div>
		</div>
		<div class="gm-section" id="gmScenarioSection" data-gm-tab="events" data-gm-advanced style="display: none;">
			<h4 class="gm-section-title">Сценарні ситуації</h4>
			<div id="gmScenarioSummary" class="gm-status-grid"></div>
			<div class="gm-round-actions">
				<button type="button" class="btn-gm-action" onclick="gmSkipScenarioChoice()">Skip pending choice</button>
			</div>
			<p class="gm-round-hint">Приватний власник карти не показується звичайному host.</p>
		</div>

		<div class="gm-section" id="omniscientHiddenSection" data-gm-tab="overview" style="display:none;">
			<h4 data-gm-i18n="omniscientHiddenTitle">Всезнаючий GM</h4>
			<p class="global-catalog-warning" data-gm-i18n="omniscientReadOnlyNotice">Спостерігач — не бере участі у грі. Read-only.</p>
			<div class="gm-diagnostics-toolbar">
				<input id="omniscientHiddenSearch" class="input-field" type="search" maxlength="100" data-gm-i18n-placeholder="omniscientHiddenSearch" placeholder="Пошук гравця або характеристики" oninput="renderOmniscientHiddenState()" />
				<button type="button" class="btn-gm-action" data-gm-i18n="omniscientRefresh" onclick="resyncOmniscientHiddenState()">Оновити</button>
			</div>
			<p id="omniscientHiddenStatus" aria-live="polite"></p>
			<div id="omniscientRoomSummary" class="gm-status-grid"></div>
			<div id="omniscientSecretVotes" class="gm-threat-audit"></div>
			<details id="omniscientDirectorControls" class="gm-threat-audit">
				<summary data-gm-i18n="directorControlsTitle">Director controls</summary>
				<p class="global-catalog-warning" data-gm-i18n="directorControlsWarning">Preview і підтвердження обов’язкові.</p>
				<div class="gm-editor-grid">
					<select id="directorTargetPlayer" class="input-field" onchange="syncDirectorControls()"></select>
					<select id="directorAction" class="input-field" onchange="syncDirectorControls()">
						<option value="reveal">Reveal characteristic</option>
						<option value="hide">Hide characteristic</option>
						<option value="reveal_all">Reveal all</option>
						<option value="hide_all">Hide all</option>
						<option value="eliminate">Eliminate</option>
						<option value="restore">Restore</option>
						<option value="condition_severity">Condition severity</option>
						<option value="condition_remove">Remove condition</option>
						<option value="pause">Pause</option>
						<option value="resume">Resume</option>
						<option value="round_forward">Forward round</option>
						<option value="reset_readiness">Reset readiness</option>
						<option value="clear_votes">Clear votes</option>
						<option value="remove_vote">Remove vote</option>
						<option value="voting_resync">Voting resync</option>
						<option value="threat_force_success">Force threat success</option>
						<option value="threat_force_failure">Force threat failure</option>
						<option value="threat_cancel">Cancel threat</option>
						<option value="threat_restart">Restart threat</option>
						<option value="threat_resync">Threat resync</option>
					</select>
					<select id="directorCategory" class="input-field"><option>Profession</option><option>PhysicalHealth</option><option>MentalHealth</option><option>Hobby</option><option>CharacterTrait</option><option>Phobia</option><option>Inventory</option><option>Property</option><option>Fact</option><option>SpecialCard</option></select>
					<input id="directorOption" class="input-field" maxlength="80" data-gm-i18n-placeholder="directorOption" placeholder="Option / severity / round" />
				</div>
				<button id="directorPreviewButton" class="btn-gm-action director-command" data-gm-i18n="directorPreview" onclick="previewDirectorAction()">Preview</button>
				<button id="directorApplyButton" class="btn-danger director-command" data-gm-i18n="directorApply" onclick="applyDirectorAction()" disabled>Apply</button>
				<pre id="directorPreviewResult" class="global-catalog-details" aria-live="polite"></pre>
			</details>
			<div id="omniscientHiddenPlayers" class="gm-diagnostics-list"></div>
		</div>

		<div class="gm-section gm-round-section" id="gmRoundSection" data-gm-tab="game" style="display: none;">
			<h4 class="gm-section-title">Керування раундом</h4>
			<section class="gm-round-control-block gm-round-state-block" aria-labelledby="gmRoundStateHeading">
				<h5 id="gmRoundStateHeading" data-gm-i18n="gmRoundCurrentState">Поточний стан</h5>
				<div class="gm-round-summary">
					<span id="gmCurrentRound">Раунд 1</span>
					<strong id="gmCurrentPhase">Розкриття характеристик</strong>
					<small id="gmRoundProgress">0/0 відкрили</small>
					<small id="gmDiceResult" class="gm-dice-result" style="display: none;"></small>
					<span id="gmPauseBadge" class="gm-status-badge">Гра триває</span>
					<small id="gmPauseReasonSummary" class="gm-pause-reason-summary" style="display: none;"></small>
				</div>
			</section>
			<section class="gm-round-control-block" aria-labelledby="gmRoundMainHeading">
				<h5 id="gmRoundMainHeading" data-gm-i18n="gmRoundMainActions">Основні дії</h5>
				<label class="gm-label" for="gmPauseReason" data-gm-i18n="gmPauseReason">Причина паузи</label>
				<input id="gmPauseReason" class="gm-select" maxlength="160" />
				<div class="gm-round-actions">
					<button class="btn-gm-action gm-round-command gm-action-secondary" data-gm-i18n="gmPause" onclick="setGamePause(true)">Пауза</button>
					<button class="btn-gm-action gm-round-command gm-action-secondary" data-gm-i18n="gmResume" onclick="setGamePause(false)">Продовжити</button>
				</div>
				<div class="gm-round-actions gm-round-main-actions">
					<button id="rollDiceBtn" class="btn-gm-action" onclick="rollRoundDice()" disabled>Кинути кубик</button>
					<button id="endRoundBtn" class="btn-gm-action gm-action-primary" onclick="endRound()" disabled>Раунд закінчено</button>
					<button id="startReadyCheckBtn" class="btn-gm-action" onclick="markAllPlayersReady()" disabled>Всі готові</button>
					<button id="gmStartVotingBtn" class="btn-gm-action" onclick="startVoting()" style="display: none;">Почати голосування</button>
				</div>
				<p id="gmVotingLockedHint" class="gm-round-hint">Голосування відкриється після завершення 3 раунду.</p>
				<div id="gmReadyStatusList" class="gm-ready-status-list" style="display: none;"></div>
				<div id="gmSpecialCardsList" class="gm-special-cards-list" style="display: none;"></div>
			</section>
			<section class="gm-round-control-block" data-gm-advanced aria-labelledby="gmManualRoundHeading">
				<h5 id="gmManualRoundHeading" data-gm-i18n="gmManualRoundHeading">Ручне встановлення раунду</h5>
				<p class="gm-round-hint" data-gm-i18n="gmManualRoundHint">Перехід можливий лише вперед; частину стану поточного раунду буде очищено.</p>
				<div class="gm-round-form-row">
					<label class="gm-field" for="gmManualRound">
						<span data-gm-i18n="gmManualRound">Номер раунду</span>
						<input id="gmManualRound" class="gm-select" type="number" min="1" max="99" step="1" />
					</label>
					<button class="btn-gm-action gm-round-command gm-action-primary" data-gm-i18n="gmPreviewRound" onclick="previewManualRoundChange()">Preview / підтвердити</button>
				</div>
			</section>
			<section class="gm-round-control-block gm-round-danger-zone" aria-labelledby="gmReadinessHeading">
				<h5 id="gmReadinessHeading" data-gm-i18n="gmReadinessHeading">Скидання готовності</h5>
				<p class="gm-round-hint" data-gm-i18n="gmReadinessHint">Очищає поточні позначки готовності після підтвердження.</p>
				<button class="btn-gm-action btn-danger gm-round-command" data-gm-i18n="gmResetReadiness" onclick="resetRoundReadiness()">Скинути готовність</button>
			</section>
			<section class="gm-round-control-block gm-timer-block" id="gmGameTimerCard" aria-labelledby="gmTimerHeading">
				<h5 id="gmTimerHeading" data-gm-i18n="gmGameTimer">Серверний таймер</h5>
				<div class="gm-timer-fields">
					<label class="gm-field" for="gmTimerMinutes"><span data-gm-i18n="gmTimerMinutes">Хвилини</span><input id="gmTimerMinutes" class="gm-select" type="number" min="0" max="120" step="1" value="5" /></label>
					<label class="gm-field" for="gmTimerSeconds"><span data-gm-i18n="gmTimerSeconds">Секунди</span><input id="gmTimerSeconds" class="gm-select" type="number" min="0" max="59" step="1" value="0" onkeydown="handleGameTimerKeydown(event)" /></label>
					<label class="gm-field" for="gmTimerPurpose">
						<span data-gm-i18n="gmTimerPurpose">Призначення</span>
						<select id="gmTimerPurpose" class="gm-select">
							<option value="Round">Round</option>
							<option value="Voting">Voting</option>
							<option value="Threat">Threat</option>
							<option value="Custom">Custom</option>
						</select>
					</label>
					<label class="gm-field" for="gmTimerLabel"><span data-gm-i18n="gmTimerName">Назва</span><input id="gmTimerLabel" class="gm-select" maxlength="80" data-gm-i18n-placeholder="gmTimerLabel" placeholder="Label" /></label>
				</div>
				<div class="gm-round-actions">
					<button id="gmTimerStart" class="btn-gm-action gm-timer-command gm-action-primary" data-gm-i18n="gmTimerStart" onclick="startGameTimer()">Старт</button>
					<button id="gmTimerPause" class="btn-gm-action gm-timer-command" data-gm-i18n="gmPause" onclick="invokeGameTimerCommand('PauseGameTimer')">Пауза</button>
					<button id="gmTimerResume" class="btn-gm-action gm-timer-command" data-gm-i18n="gmResume" onclick="invokeGameTimerCommand('ResumeGameTimer')">Продовжити</button>
					<button id="gmTimerRestart" class="btn-gm-action gm-timer-command" data-gm-i18n="gmTimerRestart" onclick="restartGameTimer()">Перезапустити</button>
					<button class="btn-gm-action gm-timer-command" onclick="adjustGameTimer(30)">+30 сек</button>
					<button class="btn-gm-action gm-timer-command" onclick="adjustGameTimer(-30)">−30 сек</button>
					<button class="btn-gm-action gm-timer-command" data-gm-i18n="gmTimerSet" onclick="setGameTimer()">Встановити</button>
					<button id="gmTimerStop" class="btn-gm-action btn-danger gm-timer-command" data-gm-i18n="gmTimerStop" onclick="stopGameTimer()">Зупинити</button>
				</div>
				<p id="gmTimerFeedback" class="gm-round-hint" aria-live="polite"></p>
			</section>
			<div class="gm-voting-admin-card" data-gm-advanced>
				<h5 data-gm-i18n="gmVotingRecovery">Відновлення голосування</h5>
				<div class="gm-round-actions">
					<button class="btn-gm-action gm-round-command" data-gm-i18n="gmClearVotes" onclick="clearCurrentVotes()">Очистити голоси</button>
					<button class="btn-gm-action gm-round-command" data-gm-i18n="gmVotingResync" onclick="resyncVotingAdmin()">Синхронізувати</button>
				</div>
				<select id="gmRemoveVoterSelect" class="gm-select"></select>
				<button class="btn-gm-action gm-round-command" data-gm-i18n="gmRemoveVote" onclick="removeSelectedVote()">Видалити голос voter</button>
				<div id="gmNonVotersList" class="gm-ready-status-list"></div>
			</div>
			<details class="gm-player-danger">
				<summary data-gm-i18n="gmUnavailableRecovery">Недоступні recovery controls</summary>
				<button class="btn-gm-action" disabled data-gm-i18n="gmStageUnavailable">Reopen/skip потребує transition helper</button>
			</details>
			<p id="gmRoundCommandResult" class="gm-round-hint" aria-live="polite"></p>
		</div>

		<div class="gm-section" id="gmVotingV2Section" data-gm-tab="voting" style="display: none;">
			<h4 class="gm-section-title">Голосування</h4>
			<div id="gmVotingV2Summary" class="gm-status-grid"></div>
			<p id="gmVotingV2Hint" class="gm-round-hint">Голосування стане доступним після третього раунду.</p>
			<div class="gm-round-actions">
				<button type="button" class="btn-gm-action gm-round-command" onclick="startVoting()">Почати голосування</button>
				<button type="button" class="btn-gm-action gm-round-command" onclick="endVoting()">Завершити голосування</button>
				<button type="button" class="btn-gm-action gm-round-command" onclick="cancelVoting()">Скасувати</button>
			</div>
			<div id="gmVotingV2NonVoters" class="gm-ready-status-list"></div>
		</div>

		<div class="gm-section" id="gmThreatControlSection" data-gm-tab="threats" style="display: none;">
			<h4 class="gm-section-title">Керування загрозою</h4>
			<div id="gmThreatCurrent" class="gm-threat-current">Поточна загроза відсутня</div>
			<div id="gmSpecificThreatControls" data-gm-advanced style="display: none;">
				<input id="gmThreatSearch" class="gm-select" type="search" placeholder="Пошук загрози..." oninput="filterGMThreatOptions()" />
				<select id="gmThreatSelect" class="gm-select"></select>
				<button class="btn-gm-action" onclick="gmSelectSpecificThreat()">Вибрати конкретну загрозу</button>
			</div>
			<div class="gm-round-actions">
				<button class="btn-gm-action" onclick="gmGenerateRareThreat()">Згенерувати випадкову рідкісну</button>
				<button class="btn-gm-action" onclick="gmGenerateTextThreat()">Згенерувати звичайну текстову</button>
				<button class="btn-gm-action" data-gm-advanced onclick="gmResyncThreatRoom()">Примусово синхронізувати кімнату</button>
			</div>
			<div class="gm-threat-danger-zone" id="gmThreatEmergencyBlock">
				<strong data-gm-i18n="gmThreatEmergency">Аварійне керування</strong>
				<button id="gmThreatResync" class="btn-gm-action" data-gm-i18n="gmThreatResync" onclick="gmResyncThreatRoom()">Оновити стан загрози</button>
				<button id="gmThreatReset" class="btn-gm-action btn-danger" data-gm-i18n="gmThreatReset" onclick="gmRestartThreat()">Перезапустити спробу</button>
				<button id="gmThreatAbort" class="btn-gm-action btn-danger" data-gm-i18n="gmThreatAbort" onclick="gmCancelThreat()">Скасувати загрозу</button>
				<button id="gmThreatForceSuccess" class="btn-gm-action gm-force-success" data-gm-i18n="gmThreatForceSuccess" onclick="requestGMThreatForcePreview('success')">Примусовий успіх</button>
				<button id="gmThreatForceFailure" class="btn-gm-action btn-danger" data-gm-i18n="gmThreatForceFailure" onclick="requestGMThreatForcePreview('failure')">Примусовий провал</button>
			</div>
			<p id="gmThreatCommandResult" class="gm-round-hint"></p>
		</div>

		@* Вибір гравця для керування через GM-панель *@
		<div class="gm-section"
			 id="gmPlayerSelectSection"
			 data-gm-tab="players"
			 style="display: none;">

			<label class="gm-label" for="gmPlayerSelect">
				Вибрати гравця:
			</label>

			<select id="gmPlayerSelect"
					name="gmPlayerSelect"
					class="gm-select"
					onchange="loadPlayerDataForGM()">
				<option value="">-- Виберіть гравця --</option>
			</select>
		</div>

		@* Інформація та дії для вибраного гравця *@
		<div id="gmPlayerInfo"
			 class="gm-player-info"
			 data-gm-tab="players"
			 style="display: none;">

			<h4 id="gmPlayerName">Гравець</h4>

			@* Швидкі дії над вибраним гравцем *@
			<div class="gm-quick-actions">
				<button type="button"
						class="btn-gm-action btn-eliminate"
						onclick="eliminateSelectedPlayer()">
					❌ Елімінувати
				</button>

				<button type="button"
						class="btn-gm-action btn-restore"
						onclick="restoreSelectedPlayer()">
					✅ Повернути
				</button>
			</div>

			<p id="gmPlayerCommandResult"
			   class="gm-round-hint"
			   aria-live="polite"></p>

			<details class="gm-player-secondary" data-gm-advanced>
				<summary data-gm-i18n="gmPlayerSecondaryActions">
					Додаткові дії
				</summary>

				<div class="gm-round-actions">
					<button type="button"
							class="btn-gm-action gm-player-command"
							data-gm-i18n="gmResyncPlayer"
							onclick="resyncSelectedPlayer()">
						Синхронізувати гравця
					</button>

					<button type="button"
							class="btn-gm-action gm-player-command"
							data-gm-i18n="gmInspectConnection"
							onclick="inspectSelectedConnection()">
						Перевірити connection
					</button>

					<button type="button"
							class="btn-gm-action gm-player-command"
							data-gm-i18n="gmTransferHost"
							onclick="transferHostToSelectedPlayer()">
						Передати host
					</button>
				</div>

				<label class="gm-label"
					   for="gmHideCharacteristicSelect"
					   data-gm-i18n="gmHideCharacteristic">
					Сховати розкриту характеристику
				</label>

				<div class="gm-round-actions">
					<select id="gmHideCharacteristicSelect"
							name="gmHideCharacteristicSelect"
							class="gm-select">
						<option value="Personality">Особистість</option>
						<option value="Body">Статура</option>
						<option value="Profession">Професія</option>
						<option value="PhysicalHealth">Фізичне здоров'я</option>
						<option value="MentalHealth">Психічне здоров'я</option>
						<option value="Hobby">Хобі</option>
						<option value="CharacterTrait">Риса характеру</option>
						<option value="Phobia">Фобія</option>
						<option value="Inventory">Інвентар</option>
						<option value="Property">Майно</option>
						<option value="Fact">Факт</option>
					</select>

					<button type="button"
							class="btn-gm-action gm-player-command"
							data-gm-i18n="gmHide"
							onclick="hideSelectedCharacteristic()">
						Сховати
					</button>
				</div>

				<div id="gmAdditionalConditions"></div>
			</details>

			<details class="gm-player-danger">
				<summary data-gm-i18n="gmDangerousActions">
					Небезпечні дії
				</summary>

				<button type="button"
						class="btn-gm-action btn-danger gm-player-command"
						data-gm-i18n="gmKickPlayer"
						onclick="kickSelectedPlayer()">
