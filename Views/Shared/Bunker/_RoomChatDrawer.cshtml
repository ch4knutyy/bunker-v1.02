<aside id="roomChatDrawer" class="room-chat-drawer" aria-labelledby="roomChatTitle" aria-hidden="true" tabindex="-1">
    <header class="room-chat-drawer-header">
        <div><span class="room-chat-kicker">Bunker comms</span><h2 id="roomChatTitle" data-i18n="roomChatTitle">Спільний чат</h2><span id="roomChatConnection" class="room-chat-connection" role="status"></span></div>
        <div class="room-chat-header-actions"><button id="addAiChatCompanionsBtn" class="btn-secondary" type="button" hidden data-i18n="roomChatAddAi">Додати AI</button><button id="toggleAiChatBtn" class="btn-secondary" type="button" hidden></button><button id="roomChatCloseButton" class="btn-close" type="button" aria-label="Close chat" data-i18n-aria-label="roomChatClose">×</button></div>
    </header>
    <div id="roomChatMessages" class="room-chat-messages" aria-live="polite" aria-relevant="additions text"></div>
    <p id="roomChatAiStatus" class="room-chat-ai-status" hidden aria-live="polite"></p>
    <form id="roomChatForm" class="room-chat-form">
        <label class="visually-hidden" for="roomChatInput" data-i18n="roomChatInputLabel">Повідомлення чату</label>
        <input id="roomChatInput" maxlength="800" autocomplete="off" placeholder="Напишіть повідомлення…" data-i18n-placeholder="roomChatPlaceholder" aria-label="Повідомлення чату" />
        <button type="submit" class="btn-success" data-i18n="roomChatSend">Надіслати</button>
    </form>
</aside>
