@{
    ViewData["Title"] = "Vault Judgment";
}

<link rel="stylesheet" href="/css/home.css" />

<div class="landing-page">
    <section class="landing-hero" aria-labelledby="landingTitle">
        <div class="landing-hero__content">
            <p class="landing-kicker">Онлайн настільна гра</p>
            <h1 id="landingTitle">Vault Judgment</h1>
            <p class="landing-lead">
                Браузерна версія гри про виживання після апокаліпсису: гравці заходять у кімнати,
                отримують випадкових персонажів, відкривають характеристики та разом вирішують,
                хто має шанс потрапити до бункера.
            </p>
            <div class="landing-actions" aria-label="Основні дії">
                <a class="landing-btn landing-btn--primary" href="/play">Почати гру</a>
                <a class="landing-btn" href="/rules">Правила</a>
                <a class="landing-btn" href="https://github.com/ch4knutyy/bunker-v1.02" target="_blank" rel="noopener noreferrer">GitHub</a>
                <a class="landing-btn" href="#author">Про автора</a>
            </div>
        </div>
    </section>

    <section id="previousSession" class="previous-session" hidden>
        <div>
            <p class="section-eyebrow">Знайдена попередня сесія</p>
            <h2>Повернутися до гри</h2>
            <dl class="session-details">
                <div>
                    <dt>Ім'я гравця</dt>
                    <dd id="previousSessionName">-</dd>
                </div>
                <div>
                    <dt>Кімната</dt>
                    <dd id="previousSessionRoom">-</dd>
                </div>
            </dl>
        </div>
        <div class="session-actions">
            <a class="landing-btn landing-btn--primary" href="/game">Повернутися</a>
            <button id="previousSessionForget" class="landing-btn landing-btn--muted" type="button">Забути сесію</button>
        </div>
    </section>

    <section class="landing-grid">
        <article class="portfolio-panel">
            <p class="section-eyebrow">Проєкт для портфоліо</p>
            <h2>Повний ігровий цикл у реальному часі</h2>
            <p>
                Vault Judgment демонструє роботу з кімнатами, live-оновленнями, локалізацією,
                відновленням сесії після оновлення сторінки та автоматизованими Playwright-перевірками.
            </p>
        </article>

        <article id="author" class="author-panel">
            <p class="section-eyebrow">Автор</p>
            <h2>Дмитро Лаптєв</h2>
            <p>
                Проєкт зібраний як практична демонстрація frontend-логіки, ASP.NET Core MVC,
                SignalR-комунікації та тестування критичних сценаріїв користувача.
            </p>
        </article>
    </section>

    <section class="landing-section">
        <div class="section-heading">
            <p class="section-eyebrow">Можливості</p>
            <h2>Що вже працює</h2>
        </div>
        <div class="features-grid">
            <div class="feature-item">Онлайн-кімнати</div>
            <div class="feature-item">Випадкова генерація персонажів</div>
            <div class="feature-item">Характеристики гравців</div>
            <div class="feature-item">Розкриття характеристик</div>
            <div class="feature-item">Локалізація UA/RU/EN</div>
            <div class="feature-item">Reconnect/session restore</div>
            <div class="feature-item">Playwright tests</div>
        </div>
    </section>

    <section class="landing-section tech-section">
        <div class="section-heading">
            <p class="section-eyebrow">Технології</p>
            <h2>Стек проєкту</h2>
        </div>
        <div class="tech-list" aria-label="Технології">
            <span>ASP.NET Core</span>
            <span>SignalR</span>
            <span>JavaScript</span>
            <span>JSON localization</span>
            <span>Playwright tests</span>
        </div>
    </section>

    <section id="player-profile" class="landing-section profile-section">
        <div class="section-heading">
            <p class="section-eyebrow">Профіль без реєстрації</p>
            <h2>Легкий профіль гравця</h2>
        </div>

        <form id="playerProfileForm" class="profile-form" autocomplete="off">
            <div class="profile-preview" aria-live="polite">
                <div id="profileAvatarPreview" class="profile-avatar-preview">◎</div>
                <div>
                    <p id="profileNamePreview" class="profile-name-preview">Гравець</p>
                    <p id="profileLanguagePreview" class="profile-meta-preview">UA</p>
                </div>
            </div>

            <div class="profile-field">
                <label for="profileName">Ім'я гравця</label>
                <input id="profileName" class="profile-input" type="text" maxlength="10" placeholder="Ваше ім'я" />
            </div>

            <div class="profile-field">
                <span class="profile-label">Аватар</span>
                <div class="avatar-picker" role="group" aria-label="Аватар">
                    <button type="button" class="avatar-option" data-avatar="◎">◎</button>
                    <button type="button" class="avatar-option" data-avatar="◆">◆</button>
                    <button type="button" class="avatar-option" data-avatar="✦">✦</button>
                    <button type="button" class="avatar-option" data-avatar="⬡">⬡</button>
                </div>
            </div>

            <div class="profile-field">
                <span class="profile-label">Колір гравця</span>
                <div class="color-picker" role="group" aria-label="Колір гравця">
                    <button type="button" class="color-option" data-color="#d89b2b" style="--swatch:#d89b2b"></button>
                    <button type="button" class="color-option" data-color="#3b8bd6" style="--swatch:#3b8bd6"></button>
                    <button type="button" class="color-option" data-color="#37c96b" style="--swatch:#37c96b"></button>
                    <button type="button" class="color-option" data-color="#d63b3b" style="--swatch:#d63b3b"></button>
                </div>
            </div>

            <div class="profile-field">
                <label for="profileLanguage">Вибрана мова</label>
                <select id="profileLanguage" class="profile-input">
                    <option value="uk">UA</option>
                    <option value="ru">RU</option>
                    <option value="en">EN</option>
                </select>
            </div>

            <dl class="profile-summary-list">
                <div>
                    <dt>Остання кімната</dt>
                    <dd id="profileLastRoom">Немає</dd>
                </div>
            </dl>

            <div class="profile-actions">
                <button class="landing-btn landing-btn--primary" type="submit">Зберегти профіль</button>
                <button id="forgetSessionBtn" class="landing-btn landing-btn--muted" type="button">Забути сесію</button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <script src="/js/home.js"></script>
}
