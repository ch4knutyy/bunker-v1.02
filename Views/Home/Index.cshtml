@{
    ViewData["Title"] = "Vault Judgment";
}

<link rel="stylesheet" href="/css/home.css" asp-append-version="true" />

<div class="landing-page">
    <section class="landing-hero" aria-labelledby="landingTitle">
        <div class="landing-hero__content">
            <p class="landing-kicker">Онлайн соціальна гра про виживання</p>

            <h1 id="landingTitle">Vault Judgment</h1>

            <p class="landing-lead">
                Браузерна версія гри «Бункер», у якій учасники отримують випадкових персонажів,
                розкривають характеристики, сперечаються, переживають загрози та голосують,
                хто залишиться у сховищі після апокаліпсису.
            </p>

            <div class="landing-actions" aria-label="Основні дії">
                <a class="landing-btn landing-btn--primary"
                   asp-controller="Games"
                   asp-action="Index">
                    Почати гру
                </a>

                <a class="landing-btn" href="/rules">Правила</a>

                <a class="landing-btn"
                   href="https://github.com/ch4knutyy/bunker-v1.02"
                   target="_blank"
                   rel="noopener noreferrer">
                    GitHub
                </a>

                <a class="landing-btn" href="#author">Про автора</a>
            </div>
        </div>
    </section>

    <section id="previousSession" class="previous-session" hidden>
        <div>
            <p class="section-eyebrow">Знайдена попередня сесія</p>
            <h2>Повернутися до гри</h2>

            <dl class="session-details">
                <div>
                    <dt>Ім'я гравця</dt>
                    <dd id="previousSessionName">-</dd>
                </div>

                <div>
                    <dt>Кімната</dt>
                    <dd id="previousSessionRoom">-</dd>
                </div>
            </dl>
        </div>

        <div class="session-actions">
            <a class="landing-btn landing-btn--primary"
               asp-controller="Bunker"
               asp-action="Index">
                Повернутися
            </a>

            <button id="previousSessionForget"
                    class="landing-btn landing-btn--muted"
                    type="button">
                Забути сесію
            </button>
        </div>
    </section>

    <section class="landing-grid">
        <article class="portfolio-panel">
            <p class="section-eyebrow">Поточний стан проєкту</p>
            <h2>Повний ігровий цикл у реальному часі</h2>

            <p>
                Vault Judgment підтримує створення кімнат, окреме лобі з ролями,
                синхронізацію через SignalR, повторне підключення, генерацію персонажів,
                раунди, розкриття характеристик, голосування, спеціальні карти,
                загрози, події бункера та завершення партії.
            </p>

            <p>
                Проєкт перебуває в активній розробці та використовується для приватного
                тестування повних партій з друзями.
            </p>
        </article>

        <article id="author" class="author-panel">
            <p class="section-eyebrow">Автор</p>
            <h2>Дмитро Лаптєв</h2>

            <p>
                Самостійний навчальний проєкт на ASP.NET Core, Razor, SignalR і JavaScript.
                Основний акцент зроблено на серверній авторизації дій, стабільному стані кімнати,
                відновленні сесій, ігровій логіці та інструментах ведучого.
            </p>
        </article>
    </section>

    <section class="landing-section">
        <div class="section-heading">
            <p class="section-eyebrow">Ігрові можливості</p>
            <h2>Що вже реалізовано</h2>
        </div>

        <div class="features-grid">
            <div class="feature-item">Онлайн-кімнати та окреме лобі</div>
            <div class="feature-item">Ролі хоста, гравців і спостерігачів</div>
            <div class="feature-item">Випадкова генерація персонажів</div>
            <div class="feature-item">Розкриття характеристик по раундах</div>
            <div class="feature-item">Голосування та вибування гравців</div>
            <div class="feature-item">Спеціальні карти й ігрові ефекти</div>
            <div class="feature-item">Каталоги бункерів та апокаліпсисів</div>
            <div class="feature-item">Загрози, операції та наслідки провалу</div>
            <div class="feature-item">Панель ведучого, таймер і ресурси</div>
            <div class="feature-item">Reconnect і відновлення сесії</div>
            <div class="feature-item">Snapshots, аудит і скасування дій</div>
            <div class="feature-item">Фінальна післяігрова хроніка</div>
            <div class="feature-item">Локалізація українською, англійською та російською</div>
        </div>
    </section>

    <section class="landing-section">
        <div class="section-heading">
            <p class="section-eyebrow">Архітектура</p>
            <h2>Стабільність і контроль стану</h2>
        </div>

        <div class="features-grid">
            <div class="feature-item">Серверна перевірка ролей і дозволів</div>
            <div class="feature-item">Синхронізація стану через SignalR</div>
            <div class="feature-item">Збереження ключових даних у SQLite</div>
            <div class="feature-item">Безпечне відновлення після перепідключення</div>
            <div class="feature-item">Журнал дій ведучого та системних подій</div>
            <div class="feature-item">Цільові Playwright і xUnit перевірки</div>
        </div>
    </section>

    <section class="landing-section tech-section">
        <div class="section-heading">
            <p class="section-eyebrow">Технології</p>
            <h2>Стек проєкту</h2>
        </div>

        <div class="tech-list" aria-label="Технології">
            <span>ASP.NET Core</span>
            <span>Razor / MVC</span>
            <span>SignalR</span>
            <span>JavaScript</span>
            <span>Entity Framework Core</span>
            <span>SQLite</span>
            <span>JSON localization</span>
            <span>Playwright</span>
            <span>xUnit</span>
        </div>
    </section>
</div>

@section Scripts {
    <script src="/js/home.js" asp-append-version="true"></script>
}
