@{
    ViewData["Title"] = "Правила";
}

<section class="mode-page" aria-labelledby="rulesTitle">
    <div class="mode-page-header">
        <h1 id="rulesTitle" data-i18n="rulesTitle">Правила</h1>
        <p data-i18n="rulesIntro">Тут будуть правила для режимів гри.</p>
    </div>

    <div class="mode-grid rules-grid">
        <article class="mode-card">
            <div class="mode-card-marker"></div>
            <h2 data-i18n="bunkerMode">Бункер</h2>
            <p data-i18n="bunkerRulesText">Правила режиму Бункер будуть додані тут.</p>
        </article>

        <article class="mode-card mode-card-disabled">
            <div class="mode-card-marker"></div>
            <h2 data-i18n="spyMode">Шпіон</h2>
            <p data-i18n="spyRulesText">Правила режиму Шпіон будуть додані пізніше.</p>
        </article>

        <article class="mode-card mode-card-disabled">
            <div class="mode-card-marker"></div>
            <h2 data-i18n="mafiaMode">Мафія</h2>
            <p data-i18n="mafiaRulesText">Правила режиму Мафія будуть додані пізніше.</p>
        </article>
    </div>
</section>
