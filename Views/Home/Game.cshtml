@{
    ViewData["Title"] = "Грати";
}

<link rel="stylesheet" href="/css/site.css" />
<link rel="stylesheet" href="/css/tooltip.css" />
<link rel="stylesheet" href="/css/game.css" />

<div class="game-container">
    <div class="top-bar">
        <h1 class="page-title">Vault Judgment</h1>
    </div>

    <!-- Lobby Section (вибір кімнати) -->
    <div id="lobbySection">
        <div class="lobby-container">
            <!-- Створення кімнати -->
            <div class="create-room-panel">
                <h2 class="section-title">Створити кімнату</h2>
                <div class="create-room-form">
                    <input id="playerNameCreate" type="text" class="input-field" placeholder="Ваше ім'я..." maxlength="10" oninput="sanitizeNameInput(this)" data-testid="player-name-input" />
                    <input id="roomName" type="text" class="input-field" placeholder="Назва кімнати..." data-testid="room-name-input" />
                    <div class="form-row">
                        <input id="maxPlayers" type="number" class="input-field small" placeholder="Макс. гравців" value="12" min="4" max="16" data-testid="room-max-players-input" />
                        <input id="roomPassword" type="password" class="input-field" placeholder="Пароль (необов'язково)" data-testid="room-password-input" />
                    </div>
                    <button type="button" id="createRoomBtn" class="btn-primary" data-testid="create-room-btn">Створити кімнату</button>
                    <p id="connectionStatus" class="connection-status" style="display: none; margin-top: 0.5rem; font-size: 0.85rem;"></p>
                </div>
            </div>

            <!-- Список кімнат -->
            <div class="rooms-list-panel">
                <h2 class="section-title">Доступні кімнати</h2>
                <div id="roomsList" class="rooms-list">
                    <p class="no-rooms">Завантаження кімнат...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Room Section (в кімнаті / лобі) -->
    <div id="roomSection" style="display: none;">
        <div class="room-header">
            <div class="room-info">
                <h2 class="room-name" id="currentRoomName">Кімната</h2>
                <span class="room-id" id="currentRoomId">ID: ---</span>
                <span class="room-state" id="currentRoomState">Лобі</span>
            </div>
            <div class="room-actions">
                <button id="copyInviteLinkBtn" class="btn-secondary" type="button" data-testid="copy-invite-link-btn" onclick="copyInviteLink()">Посилання</button>
                <button id="gmPanelBtn" class="btn-gm" onclick="toggleGMPanel()" style="display: none;">🎮 GM Панель</button>
                <button id="startVotingBtn" class="btn-vote" onclick="startVoting()" style="display: none;">🗳️ Голосування</button>
                <button id="startGameBtn" class="btn-success" onclick="startGame()" style="display: none;">Почати гру</button>
                <button class="btn-danger" onclick="leaveRoom()">Покинути кімнату</button>
            </div>
        </div>

        <div id="roundStatusPanel" class="round-status-panel" style="display: none;">
            <div class="round-status-main">
                <span class="round-status-label">Поточний раунд</span>
                <strong id="roundStatusNumber">Раунд 1</strong>
            </div>
            <div class="round-status-details">
                <span id="roundStatusPhase">Розкриття характеристик</span>
                <span id="roundStatusProgress">0/0 відкрили</span>
                <span id="roundDiceResult" class="round-dice-result" style="display: none;"></span>
            </div>
            <div id="publicGameTimer" class="public-game-timer">
                <strong id="publicGameTimerValue">05:00</strong>
                <span id="publicGameTimerStatus">Зупинено</span>
                <small id="publicGameTimerLabel"></small>
            </div>
        </div>

        <!-- Voting Panel -->
        <div id="votingPanel" class="voting-panel" style="display: none;">
            <div class="voting-header">
                <h3>🗳️ Голосування (Раунд <span id="votingRound">1</span>)</h3>
                <div class="voting-progress">
                    <span id="votingProgressText">0/0 проголосували</span>
                </div>
            </div>
            
            <div class="voting-content">
                <!-- Для гравців - вибір кандидата -->
                <div id="votingCandidates" class="voting-candidates"></div>
                
                <!-- Моє голосування -->
                <div id="myVoteStatus" class="my-vote-status" style="display: none;">
                    Ви проголосували за: <span id="myVoteTarget" class="vote-target"></span>
                </div>
            </div>
            
            <!-- Кнопки хоста -->
            <div id="votingHostControls" class="voting-host-controls" style="display: none;">
                <button class="btn-warning" onclick="endVotingEarly()">Завершити голосування</button>
                <button class="btn-secondary" onclick="cancelVoting()">Скасувати</button>
            </div>
        </div>

        <!-- Voting Results Panel (для хоста) -->
        <div id="votingResultsPanel" class="voting-results-panel" style="display: none;">
            <div class="voting-results-header">
                <h3>📊 Результати голосування</h3>
            </div>
            <div id="votingResultsContent" class="voting-results-content"></div>
            <div id="votingDecisionControls" class="voting-decision-controls">
                <p class="decision-prompt">Оберіть дію:</p>
                <button id="eliminateTopBtn" class="btn-danger" onclick="eliminateTopVoted()">❌ Елімінувати лідера</button>
                <button class="btn-success" onclick="resolveNoElimination()">✓ Нікого не елімінувати</button>
            </div>
        </div>

        <div id="readyCheckPanel" class="ready-check-panel" style="display: none;">
            <div class="ready-check-header">
                <strong>Всі готові до голосування?</strong>
                <span id="readyCheckSummary">Очікуємо відповіді гравців</span>
            </div>
            <div class="ready-check-actions">
                <button type="button" onclick="submitVotingReadyStatus('ready')">Готовий</button>
                <button type="button" onclick="submitVotingReadyStatus('add')">Хочу щось додати</button>
                <button type="button" onclick="submitVotingReadyStatus('special')">Хочу використати карту</button>
            </div>
        </div>

        <!-- Game Master Panel (тільки для хоста) -->
        <div id="gmPanel" class="gm-panel" style="display: none;">
            <div class="gm-panel-header">
                <h3>🎮 Game Master Panel</h3>
                <button class="btn-close" onclick="toggleGMPanel()">×</button>
            </div>
            <nav class="gm-tabs" aria-label="GM sections">
                <button type="button" class="gm-tab active" data-gm-tab-button="state" data-gm-i18n="gmGameState" onclick="switchGMTab('state')">Стан гри</button>
                <button type="button" class="gm-tab" data-gm-tab-button="round" data-gm-i18n="gmRoundControl" onclick="switchGMTab('round')">Керування раундом</button>
                <button type="button" class="gm-tab" data-gm-tab-button="threat" data-gm-i18n="gmThreatControl" onclick="switchGMTab('threat')">Керування загрозою</button>
                <button type="button" class="gm-tab" data-gm-tab-button="content" data-gm-i18n="gmContent" onclick="switchGMTab('content')">Контент</button>
                <button type="button" class="gm-tab" data-gm-tab-button="diagnostics" data-gm-i18n="gmDiagnostics" onclick="switchGMTab('diagnostics')">Діагностика</button>
            </nav>
            <div class="gm-panel-content">
                <div class="gm-section" id="gmGameStateSection" data-gm-tab="state">
                    <h4 class="gm-section-title">Стан гри</h4>
                    <div id="gmGameStateSummary" class="gm-status-grid"></div>
                </div>

                <div class="gm-section gm-round-section" id="gmRoundSection" data-gm-tab="round" style="display: none;">
                    <h4 class="gm-section-title">Керування раундом</h4>
                    <section class="gm-round-control-block gm-round-state-block" aria-labelledby="gmRoundStateHeading">
                        <h5 id="gmRoundStateHeading" data-gm-i18n="gmRoundCurrentState">Поточний стан</h5>
                        <div class="gm-round-summary">
                            <span id="gmCurrentRound">Раунд 1</span>
                            <strong id="gmCurrentPhase">Розкриття характеристик</strong>
                            <small id="gmRoundProgress">0/0 відкрили</small>
                            <small id="gmDiceResult" class="gm-dice-result" style="display: none;"></small>
                            <span id="gmPauseBadge" class="gm-status-badge">Гра триває</span>
                            <small id="gmPauseReasonSummary" class="gm-pause-reason-summary" style="display: none;"></small>
                        </div>
                    </section>
                    <section class="gm-round-control-block" aria-labelledby="gmRoundMainHeading">
                        <h5 id="gmRoundMainHeading" data-gm-i18n="gmRoundMainActions">Основні дії</h5>
                        <label class="gm-label" for="gmPauseReason" data-gm-i18n="gmPauseReason">Причина паузи</label>
                        <input id="gmPauseReason" class="gm-select" maxlength="160" />
                        <div class="gm-round-actions">
                            <button class="btn-gm-action gm-round-command gm-action-secondary" data-gm-i18n="gmPause" onclick="setGamePause(true)">Пауза</button>
                            <button class="btn-gm-action gm-round-command gm-action-secondary" data-gm-i18n="gmResume" onclick="setGamePause(false)">Продовжити</button>
                        </div>
                        <div class="gm-round-actions gm-round-main-actions">
                            <button id="rollDiceBtn" class="btn-gm-action" onclick="rollRoundDice()" disabled>Кинути кубик</button>
                            <button id="endRoundBtn" class="btn-gm-action gm-action-primary" onclick="endRound()" disabled>Раунд закінчено</button>
                            <button id="startReadyCheckBtn" class="btn-gm-action" onclick="markAllPlayersReady()" disabled>Всі готові</button>
                            <button id="gmStartVotingBtn" class="btn-gm-action" onclick="startVoting()" style="display: none;">Почати голосування</button>
                        </div>
                        <p id="gmVotingLockedHint" class="gm-round-hint">Голосування відкриється після завершення 3 раунду.</p>
                        <div id="gmReadyStatusList" class="gm-ready-status-list" style="display: none;"></div>
                        <div id="gmSpecialCardsList" class="gm-special-cards-list" style="display: none;"></div>
                    </section>
                    <section class="gm-round-control-block" aria-labelledby="gmManualRoundHeading">
                        <h5 id="gmManualRoundHeading" data-gm-i18n="gmManualRoundHeading">Ручне встановлення раунду</h5>
                        <p class="gm-round-hint" data-gm-i18n="gmManualRoundHint">Перехід можливий лише вперед; частину стану поточного раунду буде очищено.</p>
                        <div class="gm-round-form-row">
                            <label class="gm-field" for="gmManualRound"><span data-gm-i18n="gmManualRound">Номер раунду</span>
                                <input id="gmManualRound" class="gm-select" type="number" min="1" max="99" step="1" />
                            </label>
                            <button class="btn-gm-action gm-round-command gm-action-primary" data-gm-i18n="gmPreviewRound" onclick="previewManualRoundChange()">Preview / підтвердити</button>
                        </div>
                    </section>
                    <section class="gm-round-control-block gm-round-danger-zone" aria-labelledby="gmReadinessHeading">
                        <h5 id="gmReadinessHeading" data-gm-i18n="gmReadinessHeading">Скидання готовності</h5>
                        <p class="gm-round-hint" data-gm-i18n="gmReadinessHint">Очищає поточні позначки готовності після підтвердження.</p>
                        <button class="btn-gm-action btn-danger gm-round-command" data-gm-i18n="gmResetReadiness" onclick="resetRoundReadiness()">Скинути готовність</button>
                    </section>
                    <section class="gm-round-control-block gm-timer-block" id="gmGameTimerCard" aria-labelledby="gmTimerHeading">
                        <h5 id="gmTimerHeading" data-gm-i18n="gmGameTimer">Серверний таймер</h5>
                        <div class="gm-timer-fields">
                            <label class="gm-field" for="gmTimerMinutes"><span data-gm-i18n="gmTimerMinutes">Хвилини</span><input id="gmTimerMinutes" class="gm-select" type="number" min="0" max="120" step="1" value="5" /></label>
                            <label class="gm-field" for="gmTimerSeconds"><span data-gm-i18n="gmTimerSeconds">Секунди</span><input id="gmTimerSeconds" class="gm-select" type="number" min="0" max="59" step="1" value="0" onkeydown="handleGameTimerKeydown(event)" /></label>
                            <label class="gm-field" for="gmTimerPurpose"><span data-gm-i18n="gmTimerPurpose">Призначення</span><select id="gmTimerPurpose" class="gm-select">
                                <option value="Round">Round</option><option value="Voting">Voting</option>
                                <option value="Threat">Threat</option><option value="Custom">Custom</option>
                            </select></label>
                            <label class="gm-field" for="gmTimerLabel"><span data-gm-i18n="gmTimerName">Назва</span><input id="gmTimerLabel" class="gm-select" maxlength="80" data-gm-i18n-placeholder="gmTimerLabel" placeholder="Label" /></label>
                        </div>
                        <div class="gm-round-actions">
                            <button id="gmTimerStart" class="btn-gm-action gm-timer-command gm-action-primary" data-gm-i18n="gmTimerStart" onclick="startGameTimer()">Старт</button>
                            <button id="gmTimerPause" class="btn-gm-action gm-timer-command" data-gm-i18n="gmPause" onclick="invokeGameTimerCommand('PauseGameTimer')">Пауза</button>
                            <button id="gmTimerResume" class="btn-gm-action gm-timer-command" data-gm-i18n="gmResume" onclick="invokeGameTimerCommand('ResumeGameTimer')">Продовжити</button>
                            <button id="gmTimerRestart" class="btn-gm-action gm-timer-command" data-gm-i18n="gmTimerRestart" onclick="restartGameTimer()">Перезапустити</button>
                            <button class="btn-gm-action gm-timer-command" onclick="adjustGameTimer(30)">+30 сек</button>
                            <button class="btn-gm-action gm-timer-command" onclick="adjustGameTimer(-30)">−30 сек</button>
                            <button class="btn-gm-action gm-timer-command" data-gm-i18n="gmTimerSet" onclick="setGameTimer()">Встановити</button>
                            <button id="gmTimerStop" class="btn-gm-action btn-danger gm-timer-command" data-gm-i18n="gmTimerStop" onclick="stopGameTimer()">Зупинити</button>
                        </div>
                        <p id="gmTimerFeedback" class="gm-round-hint" aria-live="polite"></p>
                    </section>
                    <div class="gm-voting-admin-card">
                        <h5 data-gm-i18n="gmVotingRecovery">Відновлення голосування</h5>
                        <div class="gm-round-actions">
                            <button class="btn-gm-action gm-round-command" data-gm-i18n="gmClearVotes" onclick="clearCurrentVotes()">Очистити голоси</button>
                            <button class="btn-gm-action gm-round-command" data-gm-i18n="gmVotingResync" onclick="resyncVotingAdmin()">Синхронізувати</button>
                        </div>
                        <select id="gmRemoveVoterSelect" class="gm-select"></select>
                        <button class="btn-gm-action gm-round-command" data-gm-i18n="gmRemoveVote" onclick="removeSelectedVote()">Видалити голос voter</button>
                        <div id="gmNonVotersList" class="gm-ready-status-list"></div>
                    </div>
                    <details class="gm-player-danger">
                        <summary data-gm-i18n="gmUnavailableRecovery">Недоступні recovery controls</summary>
                        <button class="btn-gm-action" disabled data-gm-i18n="gmStageUnavailable">Reopen/skip потребує transition helper</button>
                    </details>
                    <p id="gmRoundCommandResult" class="gm-round-hint" aria-live="polite"></p>
                </div>

                <div class="gm-section" id="gmThreatControlSection" data-gm-tab="threat" style="display: none;">
                    <h4 class="gm-section-title">Керування загрозою</h4>
                    <div id="gmThreatCurrent" class="gm-threat-current">Поточна загроза відсутня</div>
                    <div id="gmSpecificThreatControls" style="display: none;">
                        <input id="gmThreatSearch" class="gm-select" type="search" placeholder="Пошук загрози..." oninput="filterGMThreatOptions()" />
                        <select id="gmThreatSelect" class="gm-select"></select>
                        <button class="btn-gm-action" onclick="gmSelectSpecificThreat()">Вибрати конкретну загрозу</button>
                    </div>
                    <div class="gm-round-actions">
                        <button class="btn-gm-action" onclick="gmGenerateRareThreat()">Згенерувати випадкову рідкісну</button>
                        <button class="btn-gm-action" onclick="gmGenerateTextThreat()">Згенерувати звичайну текстову</button>
                        <button class="btn-gm-action" onclick="gmResyncThreatRoom()">Примусово синхронізувати кімнату</button>
                    </div>
                    <div class="gm-threat-danger-zone" id="gmThreatEmergencyBlock">
                        <strong data-gm-i18n="gmThreatEmergency">Аварійне керування</strong>
                        <button id="gmThreatResync" class="btn-gm-action" data-gm-i18n="gmThreatResync" onclick="gmResyncThreatRoom()">Оновити стан загрози</button>
                        <button id="gmThreatReset" class="btn-gm-action btn-danger" data-gm-i18n="gmThreatReset" onclick="gmRestartThreat()">Перезапустити спробу</button>
                        <button id="gmThreatAbort" class="btn-gm-action btn-danger" data-gm-i18n="gmThreatAbort" onclick="gmCancelThreat()">Скасувати загрозу</button>
                        <button id="gmThreatForceSuccess" class="btn-gm-action gm-force-success" data-gm-i18n="gmThreatForceSuccess" onclick="requestGMThreatForcePreview('success')">Примусовий успіх</button>
                        <button id="gmThreatForceFailure" class="btn-gm-action btn-danger" data-gm-i18n="gmThreatForceFailure" onclick="requestGMThreatForcePreview('failure')">Примусовий провал</button>
                    </div>
                    <p id="gmThreatCommandResult" class="gm-round-hint"></p>
                </div>

                <!-- Вибір гравця -->
                <div class="gm-section" id="gmPlayerSelectSection" data-gm-tab="state">
                    <label class="gm-label">Вибрати гравця:</label>
                    <select id="gmPlayerSelect" class="gm-select" onchange="loadPlayerDataForGM()">
                        <option value="">-- Виберіть гравця --</option>
                    </select>
                </div>

                <!-- Інформація про вибраного гравця -->
                <div id="gmPlayerInfo" class="gm-player-info" data-gm-tab="state" style="display: none;">
                    <h4 id="gmPlayerName">Гравець</h4>
                    
                    <!-- Швидкі дії -->
                    <div class="gm-quick-actions">
                        <button class="btn-gm-action btn-eliminate" onclick="eliminateSelectedPlayer()">❌ Елімінувати</button>
                        <button class="btn-gm-action btn-restore" onclick="restoreSelectedPlayer()">✅ Повернути</button>
                    </div>
                    <p id="gmPlayerCommandResult" class="gm-round-hint" aria-live="polite"></p>
                    <details class="gm-player-secondary">
                        <summary data-gm-i18n="gmPlayerSecondaryActions">Додаткові дії</summary>
                        <div class="gm-round-actions">
                            <button class="btn-gm-action gm-player-command" data-gm-i18n="gmResyncPlayer" onclick="resyncSelectedPlayer()">Синхронізувати гравця</button>
                            <button class="btn-gm-action gm-player-command" data-gm-i18n="gmInspectConnection" onclick="inspectSelectedConnection()">Перевірити connection</button>
                            <button class="btn-gm-action gm-player-command" data-gm-i18n="gmTransferHost" onclick="transferHostToSelectedPlayer()">Передати host</button>
                        </div>
                        <label class="gm-label" data-gm-i18n="gmHideCharacteristic">Сховати розкриту характеристику</label>
                        <div class="gm-round-actions">
                            <select id="gmHideCharacteristicSelect" class="gm-select">
                                <option value="Profession">Професія</option><option value="PhysicalHealth">Фізичне здоров'я</option>
                                <option value="MentalHealth">Психічне здоров'я</option><option value="Hobby">Хобі</option>
                                <option value="CharacterTrait">Риса характеру</option><option value="Phobia">Фобія</option>
                                <option value="Inventory">Інвентар</option><option value="Fact">Факт</option>
                            </select>
                            <button class="btn-gm-action gm-player-command" data-gm-i18n="gmHide" onclick="hideSelectedCharacteristic()">Сховати</button>
                        </div>
                        <div id="gmAdditionalConditions"></div>
                    </details>
                    <details class="gm-player-danger">
                        <summary data-gm-i18n="gmDangerousActions">Небезпечні дії</summary>
                        <button class="btn-gm-action btn-danger gm-player-command" data-gm-i18n="gmKickPlayer" onclick="kickSelectedPlayer()">Виключити з кімнати</button>
                    </details>

                    <!-- Характеристики -->
                    <div class="gm-characteristics">
                        <div class="gm-char-item">
                            <span class="gm-char-name">Особистість:</span>
                            <span class="gm-char-value gm-char-hidden" id="gmPersonality">Приховано</span>
                            <div class="gm-char-actions">
                                <button onclick="peekCharacteristic('Personality')" title="Підглянути" class="btn-peek">&#128065;</button>
                                <button onclick="editCharacteristic('Personality')" title="Редагувати">✏️</button>
                                <button onclick="regenerateCharacteristic('Personality')" title="Регенерувати">🔄</button>
                                <button onclick="forceReveal('Personality')" title="Розкрити для всіх">📢</button>
                            </div>
                        </div>
                        <div class="gm-char-item">
                            <span class="gm-char-name">Статура:</span>
                            <span class="gm-char-value gm-char-hidden" id="gmBody">Приховано</span>
                            <div class="gm-char-actions">
                                <button onclick="peekCharacteristic('Body')" title="Підглянути" class="btn-peek">&#128065;</button>
                                <button onclick="editCharacteristic('Body')" title="Редагувати">✏️</button>
                                <button onclick="regenerateCharacteristic('Body')" title="Регенерувати">🔄</button>
                                <button onclick="forceReveal('Body')" title="Розкрити для всіх">📢</button>
                            </div>
                        </div>
                        <div class="gm-char-item">
                            <span class="gm-char-name">Професія:</span>
                            <span class="gm-char-value gm-char-hidden" id="gmProfession">Приховано</span>
                            <div class="gm-char-actions">
                                <button onclick="peekCharacteristic('Profession')" title="Підглянути" class="btn-peek">&#128065;</button>
                                <button onclick="editCharacteristic('Profession')" title="Редагувати">✏️</button>
                                <button onclick="regenerateCharacteristic('Profession')" title="Регенерувати">🔄</button>
                                <button onclick="forceReveal('Profession')" title="Розкрити для всіх">📢</button>
                            </div>
                        </div>
                        <div class="gm-char-item">
                            <span class="gm-char-name">Фіз. здоров'я:</span>
                            <span class="gm-char-value gm-char-hidden" id="gmPhysicalHealth">Приховано</span>
                            <div class="gm-char-actions">
                                <button onclick="peekCharacteristic('PhysicalHealth')" title="Підглянути" class="btn-peek">&#128065;</button>
                                <button onclick="editCharacteristic('PhysicalHealth')" title="Редагувати">✏️</button>
                                <button onclick="regenerateCharacteristic('PhysicalHealth')" title="Регенерувати">🔄</button>
