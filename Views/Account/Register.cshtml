@model Bunker.Models.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Реєстрація";
}

<section class="auth-shell">
    <div class="auth-card">
        <div class="auth-card-heading">
            <span class="auth-eyebrow">Vault access</span>
            <h1>Створити обліковий запис</h1>
            <p>Збережіть власне ім’я профілю для майбутніх можливостей Vault Judgment.</p>
        </div>

        <form asp-action="Register" asp-controller="Account" method="post" class="auth-form">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="auth-field">
                <label asp-for="DisplayName"></label>
                <input asp-for="DisplayName" autocomplete="name" maxlength="32" />
                <span asp-validation-for="DisplayName"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password"></span>
            </div>

            <div class="auth-field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <button type="submit" class="auth-primary">Зареєструватися</button>
        </form>

        <p class="auth-alternate">Уже маєте обліковий запис? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Увійти</a></p>
    </div>
</section>
